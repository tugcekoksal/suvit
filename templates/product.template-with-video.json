            "content": "",
            "page": "",
            "custom_liquid": "{% if product.metafields.custom.technische_daten.value %}\n  <table class=\"tech-data-table\">\n    <tbody>\n      {% for entry in product.metafields.custom.technische_daten.value %}\n        \n        {% if entry.product %}\n          <tr>\n            <th>Product</th>\n            <td>{{ entry.product }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.material %}\n          <tr>\n            <th>Material</th>\n            <td>{{ entry.material }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.farbe %}\n          <tr>\n            <th>Farbe</th>\n            <td>{{ entry.farbe }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.farben %}\n          <tr>\n            <th>Farben</th>\n            <td>{{ entry.farben }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.breite %}\n          <tr>\n            <th>Breite</th>\n            <td>{{ entry.breite | metafield_text }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.breiten %}\n          <tr>\n            <th>Breiten</th>\n            <td>{{ entry.breiten }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.hohe %}\n          <tr>\n            <th>Höhe</th>\n            <td>{{ entry.hohe | metafield_text }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.tiefe %}\n          <tr>\n            <th>Tiefe</th>\n            <td>{{ entry.tiefe | metafield_text }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.art %}\n          <tr>\n            <th>Art</th>\n            <td>{{ entry.art }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.gewicht %}\n          <tr>\n            <th>Gewicht</th>\n            <td>{{ entry.gewicht | metafield_text }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.montageart %}\n          <tr>\n            <th>Montageart</th>\n            <td>{{ entry.montageart }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.form %}\n          <tr>\n            <th>Form</th>\n            <td>{{ entry.form }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.modell %}\n          <tr>\n            <th>Modell</th>\n            <td>{{ entry.modell }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.integriertes_bidet %}\n          <tr>\n            <th>Integriertes Bidet</th>\n            <td>{{ entry.integriertes_bidet }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.tragkraft_schubladen %}\n          <tr>\n            <th>Tragkraft Schubladen</th>\n            <td>{{ entry.tragkraft_schubladen }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.tragkraft_wandmontage %}\n          <tr>\n            <th>Tragkraft Wandmontage</th>\n            <td>{{ entry.tragkraft_wandmontage }}</td>\n          </tr>\n        {% endif %}\n\n        {% if entry.schutzklasse_led %}\n          <tr>\n            <th>Schutzklasse LED</th>\n            <td>{{ entry.schutzklasse_led }}</td>\n          </tr>\n        {% endif %}\n\n      {% endfor %}\n    </tbody>\n  </table>\n{% endif %}"

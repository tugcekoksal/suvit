{
  "sections": {
    "banner": {
      "type": "main-collection-banner",
      "settings": {
        "show_collection_description": true,
        "show_collection_image": false,
        "text_color": "#9e573c",
        "overlay_color": "#c7876b",
        "overlay_opacity": 40
      }
    },
    "categories": {
      "type": "collection-categories-grid",
      "settings": {
        "title": "Alle Kategorien",
        "columns_desktop": 4,
        "columns_mobile": "2",
        "image_ratio": "1/1",
        "gap": 16,
        "card_radius": 12,
        "show_count": true,
        "skip_handles": "frontpage",
        "padding_top": 32,
        "padding_bottom": 16
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 20,
        "columns_desktop": 4,
        "pagination_type": "scroll",
        "color_scheme": "scheme-2",
        "image_ratio": "square",
        "image_shape": "default",
        "show_Video": false,
        "product_color_swatch": true,
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "enable_quick_add": "add",
        "button_style": "outline",
        "filter_type": "vertical",
        "enable_filtering": true,
        "show_color_swatch": true,
        "collapsible_Filter": true,
        "enable_sorting": true,
        "columns_mobile": "1",
        "padding_top": 20,
        "padding_bottom": 100
      }
    }
  },
  "order": [
    "banner",
    "categories",
    "product-grid"
  ]
}

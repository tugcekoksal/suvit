{%- liquid
  assign rtl = false

  if settings.lang_direction contains request.locale.iso_code
    assign rtl = true
  endif
%}
<!doctype html>
<html class="maximize-theme no-js full-height" lang="{{ request.locale.iso_code }}" dir="{% if rtl %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" sizes="48x48" href="{{ settings.favicon | image_url: width: 48, height: 48 }}">
      <link rel="icon" type="image/png" sizes="96x96" href="{{ settings.favicon | image_url: width: 96, height: 96 }}">
    {%- endif -%}

    {%- unless settings.type_header_font.system? -%}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {%- endunless -%}

    <title>{{ shop.name }}</title>
    <meta name="description" content="{{ page_description | escape }}">
    
    {% liquid 
      render 'meta-tags'
      render 'font-face'
      echo 'theme.css' | asset_url | stylesheet_tag: preload: true
      render 'css-variables'
      render 'theme-mode-control'
    %}
    {%- assign theme_sm_url     = 'theme-sm.css'     | asset_url -%}
    {%- assign theme_max_lg_url = 'theme-max-lg.css' | asset_url -%}
    {%- assign theme_md_url     = 'theme-md.css'     | asset_url -%}
    {%- assign theme_lg_url     = 'theme-lg.css'     | asset_url -%}
    {%- assign theme_xl_url     = 'theme-xl.css'     | asset_url -%}
    <link rel="preload" as="style" href="{{ theme_sm_url }}"     media="(max-width: 767px)">
    <link rel="preload" as="style" href="{{ theme_max_lg_url }}" media="(max-width: 1023px)">
    <link rel="preload" as="style" href="{{ theme_md_url }}"     media="(min-width: 768px)">
    <link rel="preload" as="style" href="{{ theme_lg_url }}"     media="(min-width: 1024px)">
    <link rel="preload" as="style" href="{{ theme_xl_url }}"     media="(min-width: 1280px)">
    <link rel="stylesheet" href="{{ theme_sm_url }}"     media="(max-width: 767px)">
    <link rel="stylesheet" href="{{ theme_max_lg_url }}" media="(max-width: 1023px)">
    <link rel="stylesheet" href="{{ theme_md_url }}"     media="(min-width: 768px)">
    <link rel="stylesheet" href="{{ theme_lg_url }}"     media="(min-width: 1024px)">
    <link rel="stylesheet" href="{{ theme_xl_url }}"     media="(min-width: 1280px)">
    {% if rtl %}
      {% liquid
        echo 'rtl.css' | asset_url | stylesheet_tag: preload: true
      %}
    {% endif %}
    {{ 'buttons.css' | asset_url | stylesheet_tag: preload: true }}

    <script src="{{ 'constants.js' | asset_url }}" defer></script>
    
    {{ content_for_header }}
  </head>

  <body class="flex flex-col h-full min-h-[100vh] scrollbar-body overflow-x-hidden text-[{{ settings.text_base_size | times: 0.007875 }}rem] md:text-[{{ settings.text_base_size | times: 0.00875 }}rem]
    {%- if settings.lang_direction contains request.locale.iso_code %} rtl{% endif -%}"
    x-data
  >
    <a class="skip-to-content absolute -z-10 button button-solid hidden lg:block pt-2.5 pb-2.5 pl-6 pr-6 lg:pt-3 lg:pb-3 mt-0.5 ml-0.5 leading-normal justify-center cursor-pointer focus-visible:z-50" href="#MainContent">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% section 'main-password-header' %}

    <main id="MainContent" class=" flex-grow">
      {{ content_for_layout }}
    </main>
    <footer>
      {% section 'main-password-footer' %}
    </footer>
    <ul hidden>
      <li id="a11y-new-window-message">{{ 'accessibility.link_messages.new_window' | t }}</li>
    </ul>

    <script>
      window.Maximize = {
        sliderScript: '{{ 'swiffy-slider.js' | asset_url }}',
        cart_quantity_error_html: '{{ 'sections.cart.cart_quantity_error_html' | t: quantity: '[quantity]' }}',
        loadedScript: [],
        buttonHoverAnm: '{{ settings.button_hover_animation }}',
        cart_add_url: '{{ routes.cart_add_url }}',
        variantStrings: {
          addToCart: `{{ 'products.product.add_to_cart' | t }}`,
          soldOut: `{{ 'products.product.sold_out' | t }}`,
          unavailable: `{{ 'products.product.unavailable' | t }}`,
        },
        routes: {
          addToCart: '{{ routes.cart_add_url }}',
          cartChange: '{{ routes.cart_change_url }}',
          cartUpdate: '{{ routes.cart_update_url }}',
          cart: '{{ routes.cart_url }}',
        },
        hasMousePointer: window.matchMedia('(hover: hover)').matches,
        cartProperties: {
          additionalFee: '_item_id'
        },
        rtl: {{ rtl }},
        giftWrappingVariantId: {% if settings.gift_wrapping_product.selected_or_first_available_variant.available %}{{ settings.gift_wrapping_product.selected_or_first_available_variant.id }}{% else %}false{% endif %},
        isShowPopupOverlay: {{ settings.show_popup_overlay }},
        checkFileNotLoaded: function () {
          const fileName = document.currentScript.src.split('/').pop().split('?')[0];
          if (!window.Maximize.loadedScript.includes(fileName)) {
            window.Maximize.loadedScript.push(fileName)
            return true;
          } else {
            return false;
          }
        },
      };
    </script>

    {%- if request.design_mode -%}
      <script src="{{ 'theme-editor-alpine-custom.js' | asset_url }}" defer></script>
      <script src="{{ 'theme-editor.js' | asset_url }}" defer></script>
    {%- endif -%}
      <script src="{{ 'theme.js' | asset_url }}" defer></script>
      <script src="{{ 'custom-elements.js' | asset_url }}" defer></script>
      <script src="{{ 'new-cart-helper.js' | asset_url }}" defer></script>
      <script src="{{ 'swiffy-slider.js' | asset_url }}" defer></script>
      <script src="{{ 'animation-card.js' | asset_url }}" defer></script>
      <script src="{{ 'product-form.js' | asset_url }}" defer></script>
      <script src="{{ 'product-card.js' | asset_url }}" defer></script>
      <script src="{{ 'vendors.js' | asset_url }}" defer></script>
  </body>
</html>

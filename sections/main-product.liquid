    {%- assign sproduct_form_id = 'sproduct-form-' | append: section.id -%}
    <div class="stickyCart sticky_{{ section.settings.sticky_position }} sticky_main gradient color-{{ block.settings.color_scheme }}" id="sticky-{{ section.id }}">
      <div class="sticky-main">
        {%- assign current_variant = product.selected_or_first_available_variant -%}
        {%- assign featured_img_src = current_variant.featured_image.src | default: product.featured_image.src -%}
        <div class="img sticky-image">
          {%- if featured_img_src -%}
            {{ featured_img_src | image_url: width: 119 | image_tag: loading: 'lazy', widths: '246, 493, 600, 713, 823, 990, 1100', onload: 'this.classList.add(`lazyloaded`)' }}
          {%- else -%}

{% comment %}
  Section: Hero Video Slider (Full width + text overlay)
  - Add videos via blocks in the theme editor sidebar
  - Text + CTA overlays the video
  - Mobile: shows static image instead of video
{% endcomment %}

<section
  id="HeroVideoSlider-{{ section.id }}"
  class="hero-video-slider"
  data-section-id="{{ section.id }}"
  style="
    --overlay: {{ section.settings.overlay_opacity | default: 45 | divided_by: 100.0 }};
    --radius: {{ section.settings.radius }}px;
    --content-max: {{ section.settings.content_max_width }}px;
  "
>
  <div class="hero-video-slider__media" aria-label="Hero video slider">
    <div class="hero-video-slider__track" role="list">
      {% for block in section.blocks %}
        {% assign idx = forloop.index0 %}
        <div
          class="hero-video-slider__slide{% if forloop.first %} is-active{% endif %}"
          role="listitem"
          data-index="{{ idx }}"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.video_shopify != blank %}
            {{
              block.settings.video_shopify
              | video_tag:
                autoplay: true,
                loop: true,
                muted: true,
                controls: false,
                playsinline: true,
                preload: "metadata",
                class: "hero-video-slider__video"
            }}
          {% elsif block.settings.video_url != blank %}
            <video
              class="hero-video-slider__video"
              autoplay
              muted
              loop
              playsinline
              webkit-playsinline
              preload="metadata"
              {% if block.settings.poster != blank %}poster="{{ block.settings.poster | image_url: width: 2000 }}"{% endif %}
            >
              <source src="{{ block.settings.video_url }}" type="video/mp4">
            </video>
          {% else %}
            <div class="hero-video-slider__placeholder">
              <p>Add a video in this slide block.</p>
            </div>
          {% endif %}

          <div class="hero-video-slider__overlay" aria-hidden="true"></div>
        </div>
      {% endfor %}
    </div>

    {%- comment -%} Mobile fallback image (shows on mobile, video hidden) {%- endcomment -%}
    {% if section.settings.mobile_fallback_image != blank %}
      <div class="hero-video-slider__mobile-image" aria-hidden="true">
        <img
          src="{{ section.settings.mobile_fallback_image | image_url: width: 1600 }}"
          alt=""
          loading="lazy"
          width="{{ section.settings.mobile_fallback_image.width }}"
          height="{{ section.settings.mobile_fallback_image.height }}"
        >
      </div>
    {% endif %}

    {%- comment -%} Content overlay ON the media {%- endcomment -%}
    <div class="hero-video-slider__content hero-video-slider__content--{{ section.settings.content_position }}">
      <div class="hero-video-slider__content-inner">
        {% if section.settings.kicker != blank %}
          <p class="hero-video-slider__kicker">{{ section.settings.kicker }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="hero-video-slider__heading">{{ section.settings.heading }}</h1>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="hero-video-slider__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.cta_label != blank and section.settings.cta_link != blank %}
          <a class="hero-video-slider__cta" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_label }}
          </a>
        {% endif %}
      </div>
    </div>

    {% if section.blocks.size > 1 %}
      <button class="hero-video-slider__nav hero-video-slider__nav--prev" type="button" aria-label="Previous slide">‹</button>
      <button class="hero-video-slider__nav hero-video-slider__nav--next" type="button" aria-label="Next slide">›</button>

      <div class="hero-video-slider__dots" role="tablist" aria-label="Slide navigation">
        {% for block in section.blocks %}
          <button
            class="hero-video-slider__dot{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-dot="{{ forloop.index0 }}"
            aria-label="Go to slide {{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            role="tab"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

<style>
  .hero-video-slider { width: 100%; }

  .hero-video-slider__media{
    position: relative;
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: #111;
    margin: 0 auto;
    max-width: {% if section.settings.full_width %}100%{% else %}min(1400px, 94vw){% endif %};

    height: {% if section.settings.full_screen %}100vh{% else %}{{ section.settings.media_height_desktop }}px{% endif %};
    min-height: {% if section.settings.full_screen %}100vh{% else %}{{ section.settings.media_height_desktop }}px{% endif %};
  }

  @media (max-width: 900px){
    .hero-video-slider__media{
      height: {% if section.settings.full_screen %}70vh{% else %}{{ section.settings.media_height_mobile }}px{% endif %};
      min-height: {% if section.settings.full_screen %}70vh{% else %}{{ section.settings.media_height_mobile }}px{% endif %};
      border-radius: {% if section.settings.full_width %}0px{% else %}var(--radius){% endif %};
      max-width: 100%;
    }
  }

  .hero-video-slider__track{ position: relative; width:100%; height:100%; }

  .hero-video-slider__slide{
    position:absolute; inset:0;
    opacity:0; transform: scale(1.02);
    transition: opacity 300ms ease, transform 600ms ease;
    pointer-events:none;
  }
  .hero-video-slider__slide.is-active{
    opacity:1; transform:scale(1);
    pointer-events:auto;
  }

  .hero-video-slider__video{ width:100%; height:100%; object-fit:cover; display:block; }

  .hero-video-slider__overlay{
    position:absolute; inset:0;
    background: rgba(0,0,0,var(--overlay));
    z-index: 1;
  }

  .hero-video-slider__placeholder{
    display:grid; place-items:center; height:100%;
    color:#fff; padding:24px; text-align:center;
    font:600 16px/1.2 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
  }

  /* Mobile fallback image */
  .hero-video-slider__mobile-image{
    display:none;
    position:absolute;
    inset:0;
    z-index:2; /* above video, below text */
  }
  .hero-video-slider__mobile-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
  }

  /* On mobile: hide video track, show fallback image */
  @media (max-width: 900px){
    .hero-video-slider__track{ display:none; }
    .hero-video-slider__mobile-image{ display:block; }
  }

  /* Overlay content */
  .hero-video-slider__content{
    position:absolute; inset:0;
    z-index:2;
    display:flex;
    padding: clamp(18px, 4vw, 56px);
  }

  .hero-video-slider__content-inner{
    width: 100%;
    max-width: var(--content-max);
    color: {{ section.settings.text_color }};
  }

  .hero-video-slider__heading,
  .hero-video-slider__kicker,
  .hero-video-slider__text{
    color: {{ section.settings.text_color }};
  }

  /* content positions */
  .hero-video-slider__content--left   { justify-content:flex-start; align-items:center; text-align:left; }
  .hero-video-slider__content--center { justify-content:center;     align-items:center; text-align:center; }
  .hero-video-slider__content--right  { justify-content:flex-end;   align-items:center; text-align:right; }

  .hero-video-slider__kicker{
    margin:0 0 10px;
    letter-spacing:0.08em; text-transform:uppercase;
    font:700 12px/1.2 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    opacity:.85;
  }

  .hero-video-slider__heading{
    margin:0 0 12px;
    font:800 clamp(30px, 4vw, 56px)/1.05 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
  }

  .hero-video-slider__text{
    margin:0 0 18px;
    font:500 16px/1.6 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    opacity:.92;
  }

  .hero-video-slider__cta{
    display:inline-flex; align-items:center; justify-content:center;
    padding:12px 18px; border-radius:6px;
    text-decoration:none;
    font:700 14px/1 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
    background: {{ section.settings.cta_bg }};
    color: {{ section.settings.cta_text }};
    border: 1px solid rgba(255,255,255,0.18);
    backdrop-filter: blur(2px);
  }
  .hero-video-slider__cta:hover{ filter: brightness(0.95); }

  /* Nav */
  .hero-video-slider__nav{
    position:absolute; top:50%; transform:translateY(-50%);
    z-index:4; width:44px; height:44px; border-radius:999px;
    border:0; background: rgba(255,255,255,0.9);
    cursor:pointer; display:grid; place-items:center;
    font-size:28px; line-height:1; user-select:none;
  }
  .hero-video-slider__nav--prev{ left:12px; }
  .hero-video-slider__nav--next{ right:12px; }

  .hero-video-slider__dots{
    position:absolute; left:50%; bottom:12px; transform:translateX(-50%);
    z-index:4; display:flex; gap:8px;
  }
  .hero-video-slider__dot{
    width:10px; height:10px; border-radius:999px;
    border:0; background: rgba(255,255,255,0.5);
    cursor:pointer;
  }
  .hero-video-slider__dot.is-active{ background: rgba(255,255,255,0.95); }
  @media (max-width: 900px){

  .hero-video-slider__mobile-image{
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .hero-video-slider__mobile-image::after{
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45); /* koyuluk seviyesi */
    z-index: 1;
  }

  .hero-video-slider__content{
    z-index: 2.5; /* yazı en üstte */
  }

}

</style>

<script>
(function () {
  const root = document.getElementById("HeroVideoSlider-{{ section.id }}");
  if (!root) return;

  // Stop slider JS entirely on mobile (since we show a static image there)
  const isMobile = window.matchMedia("(max-width: 900px)").matches;
  if (isMobile) return;

  const slides = Array.from(root.querySelectorAll(".hero-video-slider__slide"));
  const dots = Array.from(root.querySelectorAll(".hero-video-slider__dot"));
  const prevBtn = root.querySelector(".hero-video-slider__nav--prev");
  const nextBtn = root.querySelector(".hero-video-slider__nav--next");

  if (slides.length <= 1) return;

  let index = 0;
  const auto = {{ section.settings.autoplay | json }};
  const intervalMs = {{ section.settings.autoplay_interval | default: 5000 }};
  let timer = null;

  function pauseAllVideos(){
    slides.forEach(s => {
      const v = s.querySelector("video");
      if (v) v.pause();
    });
  }

  function playActiveVideo(){
    const v = slides[index].querySelector("video");
    if (!v) return;
    v.play().catch(() => {});
  }

  function setActive(i){
    index = (i + slides.length) % slides.length;
    slides.forEach((s, idx) => s.classList.toggle("is-active", idx === index));
    dots.forEach((d, idx) => {
      d.classList.toggle("is-active", idx === index);
      d.setAttribute("aria-selected", idx === index ? "true" : "false");
    });
    pauseAllVideos();
    playActiveVideo();
  }

  function start(){
    if (!auto) return;
    stop();
    timer = setInterval(() => setActive(index + 1), intervalMs);
  }

  function stop(){
    if (timer) clearInterval(timer);
    timer = null;
  }

  prevBtn && prevBtn.addEventListener("click", () => { setActive(index - 1); start(); });
  nextBtn && nextBtn.addEventListener("click", () => { setActive(index + 1); start(); });

  dots.forEach(d => {
    d.addEventListener("click", () => {
      const i = parseInt(d.getAttribute("data-dot"), 10);
      setActive(i);
      start();
    });
  });

  root.addEventListener("mouseenter", stop);
  root.addEventListener("mouseleave", start);

  setActive(0);
  start();
})();
</script>

{% schema %}
{
  "name": "Hero - Video Slider",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker (small text)", "default": "New Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Upgrade your bathroom" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Modern products, fast delivery, and premium quality.</p>" },

    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "Shop now" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },

    { "type": "color", "id": "cta_bg", "label": "CTA background", "default": "#ffffff" },
    { "type": "color", "id": "cta_text", "label": "CTA text color", "default": "#111111" },

    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },

    { "type": "image_picker", "id": "mobile_fallback_image", "label": "Mobile fallback image" },

    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },

    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": true },
    { "type": "checkbox", "id": "full_screen", "label": "Full screen height (100vh)", "default": false },

    { "type": "range", "id": "overlay_opacity", "label": "Video overlay opacity (%)", "min": 0, "max": 80, "step": 5, "default": 45 },

    { "type": "range", "id": "media_height_desktop", "label": "Media height (desktop px)", "min": 280, "max": 720, "step": 20, "default": 560 },
    { "type": "range", "id": "media_height_mobile", "label": "Media height (mobile px)", "min": 220, "max": 520, "step": 20, "default": 340 },

    { "type": "range", "id": "radius", "label": "Corner radius (px)", "min": 0, "max": 32, "step": 2, "default": 18 },
    { "type": "range", "id": "content_max_width", "label": "Content max width (px)", "min": 320, "max": 900, "step": 10, "default": 560 },

    { "type": "checkbox", "id": "autoplay", "label": "Autoplay slider", "default": true },
    { "type": "range", "id": "autoplay_interval", "label": "Autoplay interval (ms)", "min": 3000, "max": 9500, "step": 500, "default": 5000 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Video slide",
      "settings": [
        { "type": "video", "id": "video_shopify", "label": "Shopify hosted video" },
        { "type": "url", "id": "video_url", "label": "MP4 video URL (fallback)" },
        { "type": "image_picker", "id": "poster", "label": "Poster image (optional)" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Hero - Video Slider",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}

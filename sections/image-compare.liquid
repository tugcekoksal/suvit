{{ 'image-compare.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .comparison-{{ section.id }} {
    height: {{ section.settings.height }}px;
  }
  @media only screen and (max-width: 768px) {
    .comparison-{{ section.id }} {
      height: {{ section.settings.height | times: 0.75 | round: 0 }}px;
    }
  }  
  .comparison-{{ section.id }} .comparison__button::before {
    height: {{ section.settings.height }}px;
  }
  .comparison-{{ section.id }} .comparison__button::after {
    height: {{ section.settings.height }}px;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  } 
    
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div id="shopify-section-{{ section.id }}" class="color-{{ section.settings.color_scheme }} gradient shopify-section image-comparison-section section-{{ section.id }}-padding {{ section.settings.show_on }}s">
  <div class="page-width title_wrapper__image_compare text-{{ section.settings.header_alignment }}">
    <h2 class="title">{{ section.settings.heading }}</h2>
    <p class="subtitle-text_opacity subheading">{{ section.settings.description }}</p>
  </div> 
   <div class="image-compare__wrapper">
    <div class="index-section page-width color-{{ section.settings.color_scheme }} gradient">
      <image-compare class="{% if section.settings.show_marquee == true %}marquee_top_margin{% endif %} comparison imageEffect comparison-{{ section.id }} comparison--style-minimal" data-section-id="{{ section.id }}">
        <div class="comparison__draggable" data-draggable="">     
          <div class="comparison__image-wrapper" data-primary-image="">
            {%- if section.settings.image -%}            
              {% assign alt = section.settings.image.alt | escape | default: 'image-left' %}
              {{ section.settings.image | image_url: width: section.settings.image.width | image_tag:
              loading: 'lazy',
              alt: alt,
              title: alt,
              class: 'comparison__image',
              widths: '246, 493, 600, 713, 823, 990, 1000, 1500, 1900' }}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'comparison__image' }}
            {%- endif -%}
          </div>
        </div>    
        <div class="comparison__image-wrapper" data-secondary-image="">
          {%- if section.settings.image1 -%}
            {%- assign alt = section.settings.image1.alt | escape | default: 'image-right' -%}
            {{ section.settings.image1 | image_url: width: section.settings.image1.width | image_tag:
                loading: 'lazy',
                alt: alt,
                title: alt,
                class: 'comparison__image',
                widths: '246, 493, 600, 713, 823, 990, 1000, 1500, 1900' }}
          {%- else -%}
            {{ 'hero-apparel-2' | placeholder_svg_tag: 'comparison__image' }}  
          {%- endif -%}
        </div>
        <button class="comparison__button" data-button="" aria-label="comparison__button">
          {%- render 'icon' with 'comparison' -%}
        </button>
      </image-compare>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.image_compare.name",
  "tag": "section",
  "class": "section image_compare",
  "disabled_on": {
    "groups": ["header", "footer",  "custom.popup"]
  },
  "settings": [
    {
      "type": "select",
      "id": "show_on",
      "label": "t:sections.all.show_on.name",
      "options": [
        {
          "value": "small-hide",
          "label": "t:sections.all.show_on.desktop"
        },
        {
          "value": "large-up-hide medium-hide",
          "label": "t:sections.all.show_on.mobile"
        },
        {
          "value": "both",
          "label": "t:sections.all.show_on.both"
        }
      ],
      "default": "both"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.image_compare.settings.heading.label",
      "default": "Heading"
    },
    {
      "type": "text_alignment",
      "id": "header_alignment",
      "label": "t:sections.image_compare.settings.header_alignment.label",
      "default": "center"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "default": "Pair text with an image to focus on your chosen product, collection, or blog post. Add details on availability, style, or even provide a review.",
      "label": "t:sections.image_compare.settings.description.label"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.image_compare.settings.image.label",
      "info": "t:sections.image_compare.settings.image.info"
    },
    {
      "type": "image_picker",
      "id": "image1",
      "label": "t:sections.image_compare.settings.image1.label",
      "info": "t:sections.image_compare.settings.image1.info"
    },
    {
      "type": "range",
      "id": "height",
      "min": 400,
      "max": 700,
      "step": 10,
      "unit": "px",
      "label": "t:sections.image_compare.settings.height.label",
      "default": 550
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "accent-3"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "t:sections.image_compare.name"
    }
  ]
}
{% endschema %}
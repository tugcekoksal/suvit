{{ 'testimonial.css' |  asset_url |  stylesheet_tag }}

{%- style -%} 
    .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
            padding-top: {{ section.settings.padding_top }}px;
            padding-bottom: {{ section.settings.padding_bottom }}px;
        }
    }
{%- endstyle -%} 

<div class="page-width">
    <div class="testimonial {{ section.settings.show_on }} gradient color-{{ section.settings.color_scheme }} section-{{ section.id }}-padding">
        <div class="testimonial__wrapper">
            <div class="testimonial--content">
                <div class="heading-text__wrapper">
                    {%- if section.settings.title != blank -%}
                        <h2 class="inline-richtext testimonial__heading {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
                    {%- endif -%}
                </div>
                <div class="content--wrapper">
                    {%- if section.settings.subheading != blank -%}
                        <p class="subtitle-text_opacity content--text subheading">{{ section.settings.subheading }}</p>
                    {%- endif -%}
                    {%- if section.settings.button_label != blank -%}
                        <a {% if section.settings.button_link == blank %} role="link" aria-disabled="true"{%  else %} href="{{ section.settings.button_link }}"{% endif %}{% if section.settings.button_new_window %}target="_blank"{% endif %} class="testimonial__button {% if section.settings.view_all_style == 'link' %}link underlined-link cube-animation{% elsif section.settings.view_all_style == 'solid' %}button animated-button button--primary {% else %}button animated-button button--secondary{% endif %}" title="{{ section.settings.button_label | escape }}">
                            <div><span>{{ section.settings.button_label | escape }}</span></div>
                        </a>
                    {%- endif -%}
                </div>
            </div>
            <swiper-carousel>
                <div class="swiper-container">
                    <div class="swiper-wrapper testimonial-slide--content">
                        {%- for block in section.blocks -%}
                            <div class="swiper-slide">
                                <div class="testimonial__inner content-text--alignment-{{ section.settings.text_alignment }}" style="background-color: {{ block.settings.card_bg_color }};">
                                    <div class="comma_icon">
                                        {%- render 'icon' with 'comma' -%}
                                    </div>
                                    {%- if block.settings.testimonial != blank -%}
                                        <div class="subtitle-text_opacity testimonial__subtext">{{ block.settings.testimonial }}</div>
                                    {%- endif -%}
                                    <div class="author--rating">
                                        {%- if block.settings.author -%}
                                            <p class="text-subdued">{{ block.settings.author }}</p>
                                        {%- endif -%}
                                        {%- if block.settings.show_rating -%}
                                            <div class="rating">
                                                <div class="rating__stars" role="img" aria-label="{{ 'general.rating.info' | t: rating_value: block.settings.rating, rating_max: 5 }}">
                                                {%- for i in (1..5) -%}
                                                    {%- if i <= block.settings.rating -%}
                                                        {%- render 'icon' with 'rating-star', class: 'rating__star rating__star--full' -%}
                                                    {%- else -%}
                                                        {%- render 'icon' with 'rating-star', class: 'rating__star rating__star--empty' -%}
                                                    {%- endif -%}
                                                {%- endfor -%}
                                                </div>
                                            </div>
                                        {%- endif -%}
                                    </div>
                                </div>
                            </div>
                        {%- endfor -%}
                    </div>
                </div>
                <div class="arrow_progressbar slide_arrow_animated">
                    <button class="arrow_animated swiper-button-prev slider-button slider-button--prev prev-arrow" aria-label="Prev triger">
                        <span class="arrow-button">{%- render 'icon' with 'caret-animate' -%}</span>
                    </button>
                    <div class="swiper-pagination swiper-pagination-tab  position-relative mt-4 mt-md-5"></div>  
                    <button class="arrow_animated swiper-button-next slider-button slider-button--next next-arrow" aria-label="Next triger">
                        <span class="arrow-button">{%- render 'icon' with 'caret-animate' -%}</span>
                    </button>
                </div>
                <script type="application/json">
                    {         
                        "navigation": {
                            "nextEl": ".swiper-button-next",
                            "prevEl": ".swiper-button-prev"
                        },     
                        "speed": 700, 
                        "slidesPerColumnFill": "row",
                        "watchOverflow": true,
                        "slidesPerView": {{ section.settings.columns_desktop }},
                        "spaceBetween": {{ settings.spacing_grid_horizontal }}, 
                        "pagination": {
                            "el": ".swiper-pagination",
                            "type": "progressbar"
                        },
                        "breakpoints": {
                            "0": {
                                "slidesPerView": 1,
                                "spaceBetween": {{ settings.spacing_grid_horizontal | divided_by: 2 }}
                            },
                            "320": {
                                "slidesPerView": 1,
                                "spaceBetween": {{ settings.spacing_grid_horizontal | divided_by: 2 }}
                            },
                            "768": {
                                "slidesPerView": 2,
                                "spaceBetween": {{ settings.spacing_grid_horizontal | divided_by: 2 }}
                            },
                            "1200": {
                                "slidesPerView": {{ section.settings.columns_desktop }},
                                "spaceBetween": {{ settings.spacing_grid_horizontal }},
                                "freeMode": false,
                                "simulateTouch":false
                            }
                        }
                    }
                </script>
            </swiper-carousel>
        </div>
    </div>
 </div>
 
{%  schema  %} 
{
    "name": "t:sections.testimonial.name",
    "class": "section",
    "tag": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.popup"]
    },
    "settings": [
        {
            "type": "select",
            "id": "show_on",
            "label": "t:sections.all.show_on.name",
            "options": [
            {
                "value": "small-hide",
                "label": "t:sections.all.show_on.desktop"
            },
            {
                "value": "large-up-hide medium-hide",
                "label": "t:sections.all.show_on.mobile"
            },
            {
                "value": "both",
                "label": "t:sections.all.show_on.both"
            }
        ],
        "default":"both"
        },
        {
      "type": "inline_richtext",
      "id": "title",
      "default": "Testimonial",
      "label": "t:sections.multicolumn.settings.title.label"
    },
    {
    "type": "select",
    "id": "heading_size",
    "options": [
        {
            "value": "h2",
            "label": "t:sections.all.heading_size.options__1.label"
        },
        {
            "value": "h1",
            "label": "t:sections.all.heading_size.options__2.label"
        },
        {
            "value": "h0",
            "label": "t:sections.all.heading_size.options__3.label"
        }
    ],
        "default": "h1",
        "label": "t:sections.all.heading_size.label"
    },
    {
        "type": "inline_richtext",
        "id": "subheading",
        "default": "Subheading",
        "label": "t:sections.multicolumn.settings.subheading.label"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 3,
      "label": "t:sections.multicolumn.settings.columns_desktop.label"
    },
    {
        "type": "text_alignment",
        "id": "text_alignment",
        "label": "t:sections.testimonial.settings.text_alignment.label",
        "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Button label",
      "label": "t:sections.multicolumn.settings.button_label.label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.multicolumn.settings.button_link.label"
    },
    {
      "type": "checkbox",
      "id": "button_new_window",
      "label": "t:sections.image-text.blocks.content.settings.open_new_window.label",
      "default": false
    },
    {
      "type": "select",
      "id": "view_all_style",
      "label": "t:sections.all.view_all_style.label",
      "options": [
        {
          "value": "link",
          "label": "t:sections.all.view_all_style.options__1.label"
        },
        {
          "value": "outline",
          "label": "t:sections.all.view_all_style.options__2.label"
        },
        {
          "value": "solid",
          "label": "t:sections.all.view_all_style.options__3.label"
        }
      ],
        "default": "solid"
    },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.all.colors.label",
            "default": "scheme-1"
        },
        {
            "type": "header",
            "content": "t:sections.all.padding.section_padding_heading"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_top",
            "default": 36
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_bottom",
            "default": 36
        }
    ],
    "blocks": [
        {
            "type": "testimonial",
            "name": "t:sections.testimonial.blocks.name",
            "settings": [
                {
                    "type": "inline_richtext",
                    "id": "testimonial",
                    "label": "t:sections.testimonial.blocks.settings.testimonial.label",
                    "default": "Add customer reviews and testimonials to showcase your store's happy customers."
                },
                {
                    "type": "text",
                    "id": "author",
                    "label": "t:sections.testimonial.blocks.settings.author.label",
                    "default": "Author name"
                },
                {
                    "type": "checkbox",
                    "id": "show_rating",
                    "label": "Show rating",
                    "default": true
                },
                {
                    "type": "range",
                    "id": "rating",
                    "label": "Rating",
                    "min": 0,
                    "max": 5,
                    "step": 1,
                    "default": 5
                },
                {
                    "type": "color",
                    "id": "card_bg_color",
                    "label": "t:sections.multicolumn.blocks.column.settings.card_bg_color.label",
                    "default": "#FFFFFF"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.testimonial.presets.name",
            "category": "Text",
            "blocks": [
                {
                    "type": "testimonial"
                },
                {
                    "type": "testimonial"
                },
                {
                    "type": "testimonial"
                }
            ]
        }
    ]
} 
{% endschema %}  
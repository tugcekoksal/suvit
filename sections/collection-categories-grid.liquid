{% style %}
  .cat-grid-{{ section.id }} {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .cat-grid-{{ section.id }} .cat-grid-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }
  .cat-grid-{{ section.id }} .cat-grid-heading {
    font-size: 22px;
    font-weight: 600;
    margin: 0 0 20px;
    color: rgb(var(--color-foreground));
  }
  .cat-grid-{{ section.id }} .cat-grid-list {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }
  @media (min-width: 768px) {
    .cat-grid-{{ section.id }} .cat-grid-list {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    }
  }
  .cat-grid-{{ section.id }} .cat-card {
    display: block;
    text-decoration: none;
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    background: rgb(var(--color-background));
    border: 1px solid rgba(var(--color-foreground), 0.08);
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .cat-grid-{{ section.id }} .cat-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.10);
  }
  .cat-grid-{{ section.id }} .cat-card-img {
    display: block;
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    object-fit: cover;
    background: #f0ede9;
  }
  .cat-grid-{{ section.id }} .cat-card-img-placeholder {
    width: 100%;
    aspect-ratio: {{ section.settings.image_ratio }};
    background: #f0ede9;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cat-grid-{{ section.id }} .cat-card-body {
    padding: 12px 14px 14px;
  }
  .cat-grid-{{ section.id }} .cat-card-title {
    font-size: 14px;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    margin: 0 0 2px;
    line-height: 1.3;
  }
  .cat-grid-{{ section.id }} .cat-card-count {
    font-size: 12px;
    color: rgba(var(--color-foreground), 0.55);
  }
{% endstyle %}

{%- liquid
  assign skip_handles = section.settings.skip_handles | split: ','
  assign skip_handles_clean = ''
  for h in skip_handles
    assign h_clean = h | strip
    assign skip_handles_clean = skip_handles_clean | append: h_clean | append: ','
  endfor
-%}

<div class="cat-grid-{{ section.id }}">
  <div class="cat-grid-inner">
    {%- unless section.settings.title == blank -%}
      <h2 class="cat-grid-heading">{{ section.settings.title }}</h2>
    {%- endunless -%}

    <div class="cat-grid-list">
      {%- for col in collections -%}
        {%- assign col_handle_comma = col.handle | append: ',' -%}
        {%- if skip_handles_clean contains col_handle_comma -%}
          {%- continue -%}
        {%- endif -%}
        {%- if col.handle == 'alle-produkte' -%}{%- continue -%}{%- endif -%}
        {%- if col.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}

        <a href="{{ col.url }}" class="cat-card">
          {%- if col.image -%}
            <img
              class="cat-card-img"
              src="{{ col.image | image_url: width: 600 }}"
              srcset="{{ col.image | image_url: width: 400 }} 400w, {{ col.image | image_url: width: 600 }} 600w, {{ col.image | image_url: width: 800 }} 800w"
              sizes="(min-width: 768px) {{ 1200 | divided_by: section.settings.columns_desktop }}px, {{ 100 | divided_by: section.settings.columns_mobile }}vw"
              alt="{{ col.image.alt | default: col.title | escape }}"
              loading="lazy"
              width="{{ col.image.width }}"
              height="{{ col.image.height }}"
            >
          {%- elsif col.products.first.featured_image -%}
            <img
              class="cat-card-img"
              src="{{ col.products.first.featured_image | image_url: width: 600 }}"
              alt="{{ col.title | escape }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="cat-card-img-placeholder">
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {%- endif -%}

          <div class="cat-card-body">
            <div class="cat-card-title">{{ col.title }}</div>
            {%- if section.settings.show_count -%}
              <div class="cat-card-count">{{ col.products_count }} Produkte</div>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Kategorien Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Başlık",
      "default": "Alle Kategorien"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop sütun sayısı",
      "min": 2, "max": 6, "step": 1, "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobil sütun sayısı",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Görsel oranı",
      "options": [
        { "value": "1/1", "label": "Kare (1:1)" },
        { "value": "4/3", "label": "Yatay (4:3)" },
        { "value": "3/4", "label": "Dikey (3:4)" }
      ],
      "default": "1/1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Kartlar arası boşluk (px)",
      "min": 4, "max": 32, "step": 2, "default": 16
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Köşe yuvarlaklığı (px)",
      "min": 0, "max": 24, "step": 2, "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Ürün sayısını göster",
      "default": true
    },
    {
      "type": "text",
      "id": "skip_handles",
      "label": "Gizlenecek koleksiyonlar (handle, virgülle ayır)",
      "info": "Örn: frontpage,sale — alle-produkte otomatik gizlenir",
      "placeholder": "frontpage,sale"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Üst boşluk (px)",
      "min": 0, "max": 80, "step": 4, "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Alt boşluk (px)",
      "min": 0, "max": 80, "step": 4, "default": 32
    }
  ],
  "presets": [
    {
      "name": "Kategorien Grid"
    }
  ]
}
{% endschema %}

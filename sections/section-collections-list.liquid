{% liquid
  assign block_size = section.blocks.size
  assign number_of_gap = block_size | minus: 1
%}
{% style %}
  .section-{{ section.id }} {
    padding-top: calc({{ section.settings.padding_top }}px * var(--mobile-padding-ratio));
    padding-bottom: calc({{ section.settings.padding_bottom }}px * var(--mobile-padding-ratio));
  }

  .collections-list__container__{{ section.id }} > .maximize-block {
    flex-grow: {% if section.blocks.size == 1 %}if(style(--block-width: fit-content): 1; else: 0){% else %}0{% endif %};
    flex-basis: if(style(--block-width: fit-content): auto; else: calc((100% - {{ number_of_gap }} * var(--mobile-padding-ratio) * {{ section.settings.gap }}px) * var(--block-width)));
  }
  @media screen and (max-width: 767px) {
    {% if section.settings.mobile_direction == 'row' %}
      .collections-list__wrapper.section-{{ section.id }} {
        display: grid;
      }
    {% endif %}
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .section-{{ section.id }} .collections-list__container {
      gap: {{ section.settings.gap }}px;
    }
    {% if section.settings.desktop_direction == 'row' %}
      .collections-list__wrapper.section-{{ section.id }} {
        display: grid;
      }
    {% endif %}
  }
{% endstyle %}

{% render 'section-divider' %}

<div class="collections-list__wrapper relative section-{{ section.id }} {{ section.settings.section_width }} rounded-corners-container color-{{ section.settings.color_scheme_light }} dark-color-{{ section.settings.color_scheme_dark }}">
  {% if section.settings.background_media != 'none' and section.settings.desktop_background_image != blank or section.settings.mobile_background_image != blank %}
    {% liquid
      assign mobile_background_image = section.settings.mobile_background_image
      assign desktop_background_image = section.settings.desktop_background_image

      if mobile_background_image == blank
        assign mobile_background_image = desktop_background_image
      endif
      if desktop_background_image == blank
        assign desktop_background_image = mobile_background_image
      endif
    %}

    {% assign class_backgroud = 'collections-list__background__image w-full h-full object-cover rounded-corners-container' | append: ' collections-list__background__image__' | append: section.id %}
    {% style %}
      @media (max-width: 767px) {
        .collections-list__background__picture__{{ section.id }} img {
          object-position: {{ mobile_background_image.presentation.focal_point }} !important;
        }
      }

      @media (min-width: 767px) {
        .collections-list__background__picture__{{ section.id }} img {
          object-position: {{ desktop_background_image.presentation.focal_point }} !important;
        }
      }
    {% endstyle %}
    <div class="collections-list__background absolute inset-0">
      <picture class="collections-list__background__picture collections-list__background__picture__{{ section.id }} rounded-corners-container absolute w-full h-full top-0 left-0">
        <source
          media="(max-width: 767px)"
          srcset="
            {{ mobile_background_image | image_url: width: '400x' }} 400w,
            {{ mobile_background_image | image_url: width: '600x' }} 600w,
            {{ mobile_background_image | image_url: width: '800x' }} 800w
          "
          width="{{ mobile_background_image.width }}"
          height="{{ mobile_background_image.height }}"
        >
        {{- desktop_background_image | image_url: width: desktop_background_image.width
        | image_tag: loading: 'lazy',
         widths: '720,900,1080,1200,1400,1600,1800,2000,2200',
          is: 'lazy-image', class: class_backgroud,
          sizes: '100vw'
          -}}
      </picture>
      <div class="absolute inset-0 rounded-corners-container scheme-image-overlay opacity-{{ section.settings.overlay_opacity }}"></div>
    </div>
  {% endif %}
  <div class="collections-list__container collections-list__container__{{ section.id }} items-center relative z-10 flex flex-{{ section.settings.mobile_direction }} md:flex-{{ section.settings.desktop_direction }} gap-spacing" style="--gap: {{ section.settings.gap }}px;">
    {% content_for 'blocks' %}
  </div>
</div>


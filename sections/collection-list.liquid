{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
   .collection-list-text-bg {
    background: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
    padding: 24px 32px;
    border-radius: 16px;
    margin-bottom: 2rem;
  }

  .collection-list-text-bg h2,
  .collection-list-text-bg p {
    color: rgb(var(--color-foreground));
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient {{ section.settings.show_on }}">
  <div class="collection-list-wrapper page-width isolate {% if section.settings.title == blank %} no-heading{% endif %}{% if section.settings.show_view_all == false or section.blocks.size > collections.size %} no-mobile-link{% endif %} section-{{ section.id }}-padding">
    {%- unless section.settings.title == blank -%}
<div class="title-description-wrapper title-wrapper--self-padded-mobile title-wrapper--no-top-margin collection-list-text-bg">
        <h2 id="SectionHeading-{{ section.id }}" class="collection-list-title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.title }}
        </h2>
        <p class="subtitle-text_opacity rte-wrapper subheading">{{ section.settings.description }}</p>
        {%- if section.settings.show_view_all -%}
        <div class="center collection-list-view-all {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll %} data-cascade{% endif %}>
          <a href="{{ routes.collections_url }}" title="{{- 'sections.collection_list.view_all' | t -}}" class="animated-button button" aria-labelledby="ViewAllButton-{{ section.id }} SectionHeading-{{ section.id }}">
            <div><span data-text="{{- 'sections.collection_list.view_all' | t -}}">{{- 'sections.collection_list.view_all' | t -}}</span></div>
          </a>
        </div>
        {%- endif -%}
      </div>
    {%- endunless -%}
 {% if section.settings.grid_style == 'slider' %}
  <swiper-carousel>
    <div class="collection-list contains-card contains-card--collection{% if settings.card_style == 'standard' %} contains-card--standard{% endif %} collection-list--{{ section.blocks.size }}-items" id="Slider-{{ section.id }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- liquid
        assign columns = section.blocks.size
        if columns > 3
          assign columns = 3
        endif
      -%}

      <div class="swiper-container">
        <div class="swiper-wrapper">
          {%- for block in section.blocks -%}
            <div id="Slide-{{ section.id }}-{{ forloop.index }}" class="swiper-slide collection-list__item {% if block.settings.collection.featured_image == nil %} collection-list__item--no-media{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in-left{% endif %}" {{ block.shopify_attributes }} {% if settings.animations_reveal_on_scroll %} data-cascade style="--animation-order: {{ forloop.index }};" {% endif %}>
              {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
              {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
              {% render 'card-collection',
                card_collection: block.settings.collection,
                card_image: block.settings.custom_image,
                collection_label: block.settings.custom_label,
                collection_url: block.settings.custom_url,
                media_aspect_ratio: section.settings.image_ratio,
                columns: columns,
                placeholder_image: placeholder_image,
                overlay_color: block.settings.overlay_color,
                overlay_opacity: block.settings.overlay_opacity
              %}
            </div>
          {%- endfor -%}
        </div>
      </div>

      <div class="arrow_progressbar slide_arrow_animated">
        <button class="arrow_animated swiper-button-prev slider-button slider-button--prev prev-arrow" type="button" aria-label="Prev">
          <span class="arrow-button">
            {% render 'icon' with 'caret-animate' %}
          </span>
        </button>
        <div class="swiper-pagination swiper-pagination-tab position-relative mt-4 mt-md-5"></div>
        <button class="arrow_animated swiper-button-next slider-button slider-button--next next-arrow" type="button" aria-label="Next">
          <span class="arrow-button">
            {% render 'icon' with 'caret-animate' %}
          </span>
        </button>
      </div>

      <script type="application/json">
        {
          "navigation": { "nextEl": ".swiper-button-next", "prevEl": ".swiper-button-prev" },
          "speed": 700,
          "watchOverflow": true,
          "slidesPerView": {{ section.settings.columns_desktop }},
          "pagination": { "el": ".swiper-pagination", "type": "progressbar" },
          "breakpoints": {
            "0": { "slidesPerView": 1.25, "spaceBetween": {{ settings.spacing_grid_horizontal | divided_by: 2 }} },
            "768": { "slidesPerView": 2, "spaceBetween": {{ settings.spacing_grid_horizontal | divided_by: 2 }} },
            "990": { "slidesPerView": 3, "spaceBetween": {{ settings.spacing_grid_horizontal | divided_by: 2 }} },
            "1024": { "slidesPerView": {{ section.settings.columns_desktop }}, "spaceBetween": {{ settings.spacing_grid_horizontal }}, "freeMode": false, "simulateTouch": false }
          }
        }
      </script>
    </div>
  </swiper-carousel>

{% else %}

  {%- comment -%} ✅ GRID MODE (no swiper, so mobile will be grid) {%- endcomment -%}
  <div class="collection-list contains-card contains-card--collection{% if settings.card_style == 'standard' %} contains-card--standard{% endif %}">
    <div class="grid grid--1-col grid--{{ section.settings.columns_desktop }}-col-desktop">
      {%- for block in section.blocks -%}
        <div class="grid__item collection-list__item {% if block.settings.collection.featured_image == nil %} collection-list__item--no-media{% endif %}" {{ block.shopify_attributes }}>
          {%- assign placeholder_image_index = forloop.index0 | modulo: 4 | plus: 1 -%}
          {%- assign placeholder_image = 'collection-apparel-' | append: placeholder_image_index -%}
          {% render 'card-collection',
            card_collection: block.settings.collection,
            card_image: block.settings.custom_image,
            collection_label: block.settings.custom_label,
            collection_url: block.settings.custom_url,
            media_aspect_ratio: section.settings.image_ratio,
            columns: section.settings.columns_desktop,
            placeholder_image: placeholder_image,
            overlay_color: block.settings.overlay_color,
            overlay_opacity: block.settings.overlay_opacity
          %}
        </div>
      {%- endfor -%}
    </div>
  </div>

{% endif %}

  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection-list.name",
  "tag": "section",
  "class": "section section-collection-list",
  "max_blocks": 15,
  "disabled_on": {
    "templates": ["password"],
    "groups": ["header", "footer", "custom.popup"]
  },
  "settings": [
    {
      "type": "select",
      "id": "show_on",
      "label": "t:sections.all.show_on.name",
      "options": [
        {
          "value": "small-hide",
          "label": "t:sections.all.show_on.desktop"
        },
        {
          "value": "large-up-hide medium-hide",
          "label": "t:sections.all.show_on.mobile"
        },
        {
          "value": "both",
          "label": "t:sections.all.show_on.both"
        }
      ],
      "default":"both"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Collections",
      "label": "t:sections.collection-list.settings.title.label"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "inline_richtext",
      "id": "description",
      "default": "Subheading",
      "label": "t:sections.collection-list.settings.description.label"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.collection-list.settings.image_ratio.options__1.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.collection-list.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.collection-list.settings.image_ratio.options__3.label"
        }
      ],
      "default": "square",
      "label": "t:sections.collection-list.settings.image_ratio.label",
      "info": "t:sections.collection-list.settings.image_ratio.info"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "t:sections.collection-list.settings.columns_desktop.label",
      "info": "Mobile layout is automatically optimized for mobile."
    },
    {
      "type": "select",
      "id": "grid_style",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "slider",
      "label": "t:sections.featured-blog.settings.desktop_layout.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "default": false,
      "label": "t:sections.collection-list.settings.show_view_all.label"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "t:sections.collection-list.blocks.featured_collection.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.collection.label"
        },
        {
          "type": "header",
          "content": "t:sections.collection-list.blocks.featured_collection.settings.header.content"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.image.label",
          "info": "t:sections.collection-list.blocks.featured_collection.settings.image.info"
        },
        {
          "type": "text",
          "id": "custom_label",
          "label": "Custom label",
          "info" :"t:sections.collection-list.blocks.featured_collection.settings.custom_label.label"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.custom_url.label"
        },
        {
          "type": "color",
          "id": "overlay_color",
          "default": "#000000",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.overlay_color.label",
          "info": "t:sections.collection-list.blocks.featured_collection.settings.overlay_color.info"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 10,
          "unit": "%",
          "label": "t:sections.collection-list.blocks.featured_collection.settings.overlay_opacity.label",
          "info": "t:sections.collection-list.blocks.featured_collection.settings.overlay_opacity.info",
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection-list.presets.name",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}
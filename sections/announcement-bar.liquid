

{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'announcement-bar.css' |  asset_url |  stylesheet_tag }}
<div style="background:red;color:white;text-align:center;padding:8px;font-size:16px;">TEST 123 - CLAUDE TEST</div>

 
{% if section.settings.paused_hover != blank %}
  <style>
    .rotate:hover .paused {
      animation-play-state: paused !important;
    }
  </style>
{% endif %}

<div class="utility-bar color-{{ section.settings.color_scheme }} gradient{% if section.settings.show_line_separator and section.blocks.size > 0 %} utility-bar--bottom-border{% endif %}" {{ block.shopify_attributes }}>
  <div class="{% if section.settings.annoucement_style == 'slider' %}page-width{% endif %} {% if section.settings.annoucement_style == 'marquee' %}marquee{% endif %}">
    {%- if section.settings.annoucement_style == 'marquee' -%}
      <div class="rotate {{ section.settings.direction }}">
        {%- for i in (1..20) -%}   
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'announcement' -%}
                <div class="announcement-bar__message rte inline-richtext text-center {% if section.settings.annoucement_style == 'marquee' %}marqueeslide {% if section.settings.paused_hover %}paused{% endif %} {% else %}swiper-slide{% endif %}" {{ block.shopify_attributes }}>
                  {%- if block.settings.text != blank -%}
                    {{- block.settings.text -}}
                  {%- endif -%}
                </div>  
            {%- endcase -%}   
          {%- endfor -%}
        {% endfor %} 
      </div>
    {%- else -%}
      {%- if section.blocks.size == 1 -%}
        <div class="announcement-bar"role="region" aria-label="{{ 'sections.header.announcement' | t }}">
          {%- if section.blocks.first.settings.text != blank -%}
            <p class="announcement-bar__message rte inline-richtext">{{ section.blocks.first.settings.text }}</p>
          {%- endif -%} 
        </div>
      {%- elsif section.blocks.size > 1 -%}
        <slideshow-component class="announcement-bar" role="region" aria-roledescription="{{ 'sections.announcements.carousel' | t }}" aria-label="{{ 'sections.announcements.announcement_bar' | t }}">
          <div class="announcement-bar-slider slider-buttons">
            <button type="button" class="arrow_animated slider-button slider-button--prev {% if section.settings.hidearrow  == false %}hidden{% endif %}" name="previous" aria-label="{{ 'sections.announcements.previous_announcement' | t }}" aria-controls="Slider-{{ section.id }}">
              <span class="arrow-button">{% render 'icon' with 'caret-animate' %}</span>
            </button>
            <div class="grid grid--1-col slider slider--everywhere" id="Slider-{{ section.id }}" aria-live="polite" aria-atomic="true" data-autoplay="{{ section.settings.auto_rotate }}" data-speed="{{ section.settings.change_slides_speed }}">
              {%- for block in section.blocks -%}
                <div class="slideshow__slide slider__slide grid__item grid--1-col" id="Slide-{{ section.id }}-{{ forloop.index }}"{{ block.shopify_attributes }} role="group" aria-roledescription="{{ 'sections.announcements.announcement' | t }}" aria-label="{{ forloop.index }} {{ 'general.slider.of' | t }} {{ forloop.length }}" tabindex="-1">
                  <div class="announcement-bar__announcement" role="region"aria-label="{{ 'sections.header.announcement' | t }}"{{ block.shopify_attributes }}>
                    {%- if block.settings.text != blank -%}
                      <p class="announcement-bar__message rte inline-richtext">{{ block.settings.text }}</p>
                    {%- endif -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
            <button type="button" class="arrow_animated slider-button slider-button--next {% if section.settings.hidearrow == false %}hidden{% endif %}" name="next" aria-label="{{ 'sections.announcements.next_announcement' | t }}" aria-controls="Slider-{{ section.id }}">
              <span class="arrow-button">{% render 'icon' with 'caret-animate' %}</span>
            </button>
          </div>
        </slideshow-component>
      {%- if request.design_mode -%}
        <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
      {%- endif -%}
    {%- endif -%}
  {%- endif -%} 
  </div>
</div>

{% schema %}

{
  "name": "t:sections.announcement-bar.name",
  "max_blocks": 12,
  "class": "announcement-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "checkbox",
      "id": "show_line_separator",
      "default": true,
      "label": "t:sections.header.settings.show_line_separator.label"
    },
    {
      "type": "select",
       "id": "annoucement_style",
       "label": "t:sections.announcement-bar.settings.announcement_style.label",
       "options": [
        {
          "value": "marquee",
          "label": "t:sections.announcement-bar.settings.announcement_style.marquee"
        },
        {
          "value": "slider",
          "label": "t:sections.announcement-bar.settings.announcement_style.slider"
        }
       ],
       "default": "slider"
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header1.content"
    },    
    {
      "type": "select",
      "id": "direction",
      "label": "t:sections.announcement-bar.settings.direction.label",
      "info": "t:sections.announcement-bar.settings.direction.info",
      "options": [
        {
          "value": "left_right",
          "label": "t:sections.announcement-bar.settings.direction.left_right"
        }, 
        {
          "value": "right_left",
          "label": "t:sections.announcement-bar.settings.direction.right_left"
        }
      ],
      "default": "right_left"
    },
    {
    "type": "checkbox",
    "id": "paused_hover",
    "label": "t:sections.announcement-bar.settings.paused_hover.label",
    "default": false
    },
    {
      "type": "header",
      "content": "t:sections.announcement-bar.settings.header.content"
    },
    {
      "type": "checkbox",
      "id": "hidearrow",
      "label": "t:sections.announcement-bar.settings.hidearrow.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "t:sections.announcement-bar.settings.auto_rotate.label",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slides_speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "t:sections.announcement-bar.settings.change_slides_speed.label",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "t:sections.announcement-bar.blocks.announcement.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Welcome to our store",
          "label": "t:sections.announcement-bar.blocks.announcement.settings.text.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement-bar.presets.name",
      "blocks": [
        {
          "type": "announcement"
        }
      ]
    }
  ]
}

{% endschema %}


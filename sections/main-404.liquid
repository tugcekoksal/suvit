{%-  style -%}
.template--404__main {
    border-radius: 2rem;
}
.errorpage_container{
  height: 100%;
  border-radius: 2rem;
  padding: 3rem 2rem 5rem;

}
.errorpage__heading {
  font-size: 8rem;
  margin: 0;
}
.errorpage__subtitle {
  font-size: 2rem;
  font-weight: 300;
  margin: 0;
} 
.errorpage__button{
  margin-top: 3.2rem;
} 
@media screen and (min-width: 750px) {
  .errorpage_container {
    padding: 2rem 3.9rem 4rem;
  }
  .errorpage__heading {
    font-size: 9.4rem;
    font-weight: 700;
  }
  .errorpage__subtitle {
    font-size: 2.4rem;
  } 
}
@media screen and (min-width: 990px) {
  .errorpage_container {
    padding: 2rem 6.9rem 4rem;
  }
}
@media screen and (min-width: 1124px) {
  .errorpage_container {
    padding: 2rem 11rem 4rem;
  }
}
{%- endstyle -%}

<div class="page-width">
  <div class="template-404 template--404__main page-margin center color-{{ section.settings.color_scheme }} gradient">
    <div class="errorpage_container">
      <h2 class="errorpage__heading rte">{{ 'templates.404.subtext' | t }}</h2>
      <p class="errorpage__subtitle">{{ 'templates.404.title' | t }}</p>
      <a href="{{ routes.all_products_collection_url }}" title="{{ 'general.continue_shopping' | t }}" class="button errorpage__button button--secondary animated-button">
        <div><span>{{ 'general.continue_shopping' | t }}</span></div>
      </a>
    </div>
  </div>
</div>

{%  schema  %} 
{
  "name": "Main 404",
  "settings": [
    {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "default": "scheme-2"
    }
  ]
}
{% endschema %} 
{{ 'icon-with-text.css' |  asset_url |  stylesheet_tag }}

{%- style -%} 
    .section-{{ section.id }}-padding{
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
            padding-top: {{ section.settings.padding_top }}px;
            padding-bottom: {{ section.settings.padding_bottom }}px;
        }
    }
{%- endstyle -%}

<div class="icon-with-text page-width color-{{ section.settings.color_scheme }} {{ section.settings.show_on }} gradient section-{{ section.id }}-padding">
    <div class="icon-with-text__wrapper">
        <div class="content__wrapper content-alignmnet--{{ section.settings.text_alignment }} mobile-content-alignmnet--{{ section.settings.mobile_text_alignment }}">
            {%- if section.settings.heading != blank -%}
                <h2 class="title">{{ section.settings.heading }}</h2>
            {%- endif -%}
            {%- if section.settings.subheading != blank -%}
                <P class="text-content subtitle-text_opacity subheading">{{ section.settings.subheading }}</P>
            {%- endif -%}
            {%- if section.settings.button_label != blank -%}
                <a {% if section.settings.button_link == blank %} role="link" aria-disabled="true"{%  else %} href="{{ section.settings.button_link }}"{% endif %}{% if section.settings.button_new_window %}target="_blank"{% endif %} title="{{ section.settings.button_label | escape }}" class="main_button_top {% if section.settings.view_all_style == 'link' %}link underlined-link cube-animation{% elsif section.settings.view_all_style == 'solid' %}button button--primary animated-button {% else %}button animated-button button--secondary{% endif %}">
                    <div><span>{{ section.settings.button_label | escape }}</span></div>
                </a>
            {%- endif -%} 
        </div>
        <div class="icon-text-content__inner small-hide">
            {%- for block in section.blocks -%}
                <div class="icon-text__content">
                    {%- if block.settings.icon != blank -%}
                        <div class="icon__image">
                            {{ block.settings.icon | image_url: width: block.settings.icon.width | image_tag: widths: '32, 64, 128, 246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946'}}  
                        </div>
                    {%- endif -%}
                    {%- if block.settings.text_heading != blank -%}
                        <h2 class="text-content-heading">{{ block.settings.text_heading }}</h2> 
                    {%- endif -%}
                    {%- if block.settings.content != blank -%}
                        <div class="subtitle-text_opacity subtitle__text">{{ block.settings.content }}</div>
                    {%- endif -%}
                </div>
            {%- endfor -%}
        </div>
        <swiper-carousel class="large-up-hide medium-hide">
            <div class="swiper-container" {% if request.locale.iso_code == "ar" %}dir="rtl" {% endif %}>
                <div class="swiper-wrapper icon-text__slide">
                    {%- for block in section.blocks -%}
                        <div class="icon-text__content swiper-slide">
                            {%- if block.settings.icon != blank -%}
                                <div class="icon__image">
                                    {{ block.settings.icon | image_url: width: block.settings.icon.width | image_tag: loading: lazy, sizes: sizes,widths: '32, 64, 128, 246, 493, 600, 713, 823, 990, 1100, 1206, 1346, 1426, 1646, 1946'}}  
                                </div>
                            {%- endif -%}
                            {%- if block.settings.text_heading != blank -%}
                                <h2 class="text-content-heading">{{ block.settings.text_heading }}</h2> 
                            {%- endif -%}
                            {%- if block.settings.content != blank -%}
                                <div class="subtitle-text_opacity subtitle__text">{{ block.settings.content }}</div>
                            {%- endif -%}
                        </div>
                    {%- endfor -%}
                </div>
            </div>
            <div class="arrow_progressbar slide_arrow_animated">
                <button class="arrow_animated swiper-button-prev slider-button slider-button--prev prev-arrow" aria-label="Prev triger">
                  <span class="arrow-button">
                    {%- render 'icon' with 'caret-animate' -%}
                  </span>
                </button>
                <div class="swiper-pagination swiper-pagination-tab  position-relative mt-4 mt-md-5"></div>  
                <button class="arrow_animated swiper-button-next slider-button slider-button--next next-arrow" aria-label="Next triger">
                  <span class="arrow-button">
                    {%- render 'icon' with 'caret-animate' -%}
                  </span>
                </button>
            </div>
            <script type="application/json">
                {
                    "speed": 700,
                    "grabCursor": true,
                    "spaceBetween": 30,
                    "slidesPerView": 1,
                    "pagination": {
                        "el": ".swiper-pagination",
                        "type": "progressbar",
                        "clickable": true
                    },
                    "navigation": {
                        "nextEl": ".swiper-button-next",
                        "prevEl": ".swiper-button-prev"
                    }
                }
            </script>
        </swiper-carousel>
    </div>
</div>

{%- schema -%} 
{
    "name": "t:sections.icon_with_text.name",
    "tag": "section",
    "class": "section",
    "disabled_on": {
        "groups": ["header", "footer", "custom.popup"]
    },
    "settings": [
        {
            "type": "select",
            "id": "show_on",
            "label": "t:sections.all.show_on.name",
            "options": [
                {
                "value": "small-hide",
                "label": "t:sections.all.show_on.desktop"
                },
                {
                "value": "large-up-hide medium-hide",
                "label": "t:sections.all.show_on.mobile"
                },
                {
                "value": "both",
                "label": "t:sections.all.show_on.both"
                }
            ],
            "default": "both"
        },
        {
            "type": "text",
            "id": "heading",
            "default": "Heading",
            "label": "t:sections.icon_with_text.settings.heading.label"
        },
        {
            "type": "inline_richtext",
            "id": "subheading",
            "default": "Here you can add short description for the icon with text",
            "label": "t:sections.icon_with_text.settings.subheading.label"
        },
        {
            "type": "text",
            "id": "button_label",
            "default": "Button label",
            "label": "t:sections.image-text.blocks.content.settings.button_label.label",
            "info": "t:sections.image-text.blocks.content.settings.button_label.info"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "t:sections.image-text.blocks.content.settings.button_url.label"
        },
        {
            "type": "checkbox",
            "id": "button_new_window",
            "label": "t:sections.image-text.blocks.content.settings.open_new_window.label",
            "default": false
        },
        {
            "type": "select",
            "id": "view_all_style",
            "label": "t:sections.all.view_all_style.label",
            "options": [
                {
                    "value": "link",
                    "label": "t:sections.all.view_all_style.options__1.label"
                },
                {
                    "value": "outline",
                    "label": "t:sections.all.view_all_style.options__2.label"
                },
                {
                    "value": "solid",
                    "label": "t:sections.all.view_all_style.options__3.label"
                }
            ],
                "default": "solid"
        },
        {
            "type": "text_alignment",
            "id": "text_alignment",
            "label": "t:sections.icon_with_text.settings.text_alignment.label",
            "default": "left"
        },
        {
            "type": "text_alignment",
            "id": "mobile_text_alignment",
            "label": "t:sections.icon_with_text.settings.mobile_text_alignment.label",
            "default": "center"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.all.colors.label",
            "default": "scheme-1"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_top",
            "default": 24
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_bottom",
            "default": 24
        }
    ],
    "blocks": [
        {
            "type": "image",
            "name": "t:sections.icon_with_text.blocks.name",
            "limit": 4,
            "settings": [
                {
                    "type": "image_picker",
                    "id": "icon",
                    "label": "t:sections.icon_with_text.blocks.settings.image.label",
                    "info": "t:sections.icon_with_text.blocks.settings.image.info"
                },
                {
                    "type": "text",
                    "id": "text_heading",
                    "label": "t:sections.icon_with_text.blocks.settings.text_heading.label",
                    "default": "Heading"
                },
                {
                    "type": "richtext",
                    "id": "content",
                    "label": "t:sections.icon_with_text.blocks.settings.subtitle.label",
                    "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "t:sections.icon_with_text.presets.name",
            "blocks": [
                {
                    "type": "image"
                },
                {
                    "type": "image"
                },
                {
                    "type": "image"
                },
                {
                    "type": "image"
                }
            ]
        }
    ]
}
{%- endschema -%}
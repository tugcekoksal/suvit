{% comment %}
  Product FAQs powered by Metaobjects (list)
  - Product metafield references metaobject type faq (list)
  - Metaobject fields: question, answer
{% endcomment %}

{% liquid
  assign mf_path = section.settings.faq_metafield | default: "custom.fqa"
  assign parts = mf_path | split: "."
  assign mf_namespace = parts[0]
  assign mf_key = parts[1]

  assign mf = blank
  if mf_namespace != blank and mf_key != blank
    assign mf = product.metafields[mf_namespace][mf_key]
  endif

  assign faqs = blank
  if mf != blank
    assign faqs = mf.value
  endif
%}

{% if faqs != blank %}
  <section class="product-faqs" id="product-faqs">
    {% if section.settings.title != blank %}
      <h2 class="product-faqs__title">{{ section.settings.title }}</h2>
    {% endif %}

    {% if section.settings.subtitle != blank %}
      <div class="product-faqs__subtitle rte">
        {{ section.settings.subtitle }}
      </div>
    {% endif %}

    <div class="product-faqs__items">
      {% for item in faqs %}
        {% assign q = item.question %}
        {% assign a = item.answer %}

        {% if q != blank and a != blank %}
          <details class="product-faqs__item" {% if section.settings.open_first and forloop.first %}open{% endif %}>
            <summary class="product-faqs__question">
              <span>{{ q }}</span>
              <span class="product-faqs__icon" aria-hidden="true"></span>
            </summary>

            <div class="product-faqs__answer">
              {{ a }}
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </section>

 <style>
  .product-faqs {
    background-color:#FAF1E7;
    margin: 2.5rem 0;
    padding:35px;
    border-top:0.5px solid #C7876B;
    border-bottom:0.5px solid #C7876B;
  }

  .product-faqs__title {
    margin: 0 0 0.75rem;
    padding-bottom:25px;
  }

  .product-faqs__subtitle {
    margin: 0 0 1.25rem;
    opacity: .9;
  }

  .product-faqs__items {
    display: grid;
    gap: .75rem;
  }

  .product-faqs__item {
    border: 1px solid rgba(0,0,0,.12);
    border-radius: 12px;
    padding: .25rem 0;
  }

  /* ✅ QUESTION ROW */
  .product-faqs__question {
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 35px; /* 👈 35px horizontal padding */
    font-weight: 600;
  }

  .product-faqs__question::-webkit-details-marker {
    display: none;
  }

  /* ✅ ARROW ICON */
  .product-faqs__icon {
    width: 10px;
    height: 10px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.25s ease;
    flex-shrink: 0;
    margin-left: 12px;
  }

  /* 🔽 Rotate arrow when open */
  details[open] .product-faqs__icon {
    transform: rotate(-135deg);
  }

  /* ✅ ANSWER */
  .product-faqs__answer {
    padding: 0 35px 1rem 35px; /* 👈 35px horizontal padding */
  }
</style>

  <script>
    (function () {
      var root = document.getElementById('product-faqs');
      if (!root) return;

      var singleOpen = {{ section.settings.single_open | json }};
      if (!singleOpen) return;

      var items = root.querySelectorAll('details.product-faqs__item');
      items.forEach(function (d) {
        d.addEventListener('toggle', function () {
          if (!d.open) return;
          items.forEach(function (other) {
            if (other !== d) other.removeAttribute('open');
          });
        });
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Product FAQs",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Häufige Fragen"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle (optional)"
    },
    {
      "type": "text",
      "id": "fqa_metafield",
      "label": "Product metafield (namespace.key)",
      "default": "custom.fqa",
      "info": "Example: custom.fqa"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open first item by default",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "single_open",
      "label": "Only one item open at a time",
      "default": true
    }
  ],
  "presets": [
    { "name": "Product FAQs" }
  ]
}
{% endschema %}

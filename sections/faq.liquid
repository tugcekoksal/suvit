{{ 'faq.css' |  asset_url |  stylesheet_tag }}
{{ 'component-accordion.css' | asset_url | stylesheet_tag }}

{%- style -%} 
    .section-{{ section.id }}-padding{
        padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
        padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    @media screen and (min-width: 750px) {
        .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
        }
    }
 {%- endstyle -%}

<div class="page-width {{ section.settings.show_on }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
    <div class="faq-content__wrapper">
        <div class="content__wrapper faq-content-alignmnet--{{ section.settings.text_alignment }}">
            {% if section.settings.title != blank %}
                <h2 class="title faq-content_heading">{{ section.settings.title }}</h2>
            {% endif %}
            {% if section.settings.subheading != blank %}
                <P class="text-content subtitle-text_opacity subheading">{{ section.settings.subheading }}</P>
            {% endif %}
            {%- if section.settings.button_label != blank -%}
                <a {% if section.settings.button_link == blank %} role="link" aria-disabled="true"{% else %} href="{{ section.settings.button_link }}"{% endif %}{% if section.settings.button_new_window %}target="_blank"{% endif %} title="{{ section.settings.button_label | escape }}" class="main_button_top {% if section.settings.view_all_style == 'link' %}link underlined-link cube-animation{% elsif section.settings.view_all_style == 'solid' %}button button--primary animated-button {% else %}button animated-button button--secondary{% endif %}">
                    <div><span>{{ section.settings.button_label | escape }}</span></div>
                </a>
            {%- endif -%} 
        </div>
        <div class="faq-collaps__inner">
            {% for block in section.blocks %}
                <div div class="accordion" {% if section.settings.open_first_collapsible_row and forloop.first %} data-expand="true" {% endif %}>
                    <collapsible-content class="collapsible_summary accordion_summary" data-section="{{ section.id }}" tabindex="0">
                        <h2 class="accordion__title summary__title inline-richtext h4">
                            {{ block.settings.heading | default: block.settings.page.title | escape }}
                        </h2>
                        <span>{% render 'icon' with 'caret' %}</span>
                    </collapsible-content>
                    <div class="accordion__content rte">
                        {%- if block.settings.row_content != blank-%}
                            {{ block.settings.row_content }}
                        {%- else block.settings.page.content -%}
                            {{ block.settings.page.content }}
                        {%- endif -%}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

{%  schema  %} 
{
    "name": "t:sections.faq.name",
    "class": "section",
    "tag": "section",
    "disabled_on": {        
        "groups": ["header", "footer", "custom.popup"]
    },
    "settings": [
        {
            "type": "select",
            "id": "show_on",
            "label": "t:sections.all.show_on.name",
            "options": [
                {
                    "value": "small-hide",
                    "label": "t:sections.all.show_on.desktop"
                },
                {
                    "value": "large-up-hide medium-hide",
                    "label": "t:sections.all.show_on.mobile"
                },
                {
                    "value": "both",
                    "label": "t:sections.all.show_on.both"
                }
            ],
            "default": "both"
        },
        {
            "type": "text",
            "id": "title",
            "default": "Heading",
            "label": "t:sections.icon_with_text.settings.heading.label"
        },
        {
            "type": "inline_richtext",
            "id": "subheading",
            "default": "Here you can add short description for the icon with text",
            "label": "t:sections.icon_with_text.settings.subheading.label"
        },
        {
            "type": "text",
            "id": "button_label",
            "default": "Button label",
            "label": "t:sections.image-text.blocks.content.settings.button_label.label",
            "info": "t:sections.image-text.blocks.content.settings.button_label.info"
        },
        {
            "type": "url",
            "id": "button_link",
            "label": "t:sections.image-text.blocks.content.settings.button_url.label"
        },
        {
            "type": "checkbox",
            "id": "button_new_window",
            "label": "t:sections.image-text.blocks.content.settings.open_new_window.label",
            "default": false
        },
        {
            "type": "select",
            "id": "view_all_style",
            "label": "t:sections.all.view_all_style.label",
            "options": [
                {
                    "value": "link",
                    "label": "t:sections.all.view_all_style.options__1.label"
                },
                {
                    "value": "outline",
                    "label": "t:sections.all.view_all_style.options__2.label"
                },
                {
                    "value": "solid",
                    "label": "t:sections.all.view_all_style.options__3.label"
                }
            ],
                "default": "solid"
        },
        {
            "type": "text_alignment",
            "id": "text_alignment",
            "label": "t:sections.faq.settings.text_alignmnet.label",
            "default": "left"
        },
        {
            "type": "checkbox",
            "id": "open_first_collapsible_row",
            "default": false,
            "label": "t:sections.collapsible_content.settings.open_first_collapsible_row.label"
        },
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "t:sections.all.colors.label",
            "default": "scheme-1"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_top",
            "default": 24
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 100,
            "step": 4,
            "unit": "px",
            "label": "t:sections.all.padding.padding_bottom",
            "default": 24
        }
    ],
    "blocks": [
        {
            "type": "faq_row",
            "name": "t:sections.faq.block.name",
            "settings": [
                {
                    "type": "text",
                    "id": "heading",
                    "default": "Faq row",
                    "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.heading.label",
                    "info": "t:sections.collapsible_content.blocks.collapsible_row.settings.heading.info"
                },
                {
                    "type": "richtext",
                    "id": "row_content",
                    "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.row_content.label",
                    "default": "<p>Use this section for add your own custom content to give more information.</p>"
                },
                {
                    "type": "page",
                    "id": "page",
                    "label": "t:sections.collapsible_content.blocks.collapsible_row.settings.page.label"
                }
            ]
        }
    ],
    "presets": [
    {
      "name": "t:sections.faq.presets.name",
      "blocks": [
        {
          "type": "faq_row"
        },
        {
          "type": "faq_row"
        },
        {
          "type": "faq_row"
        },
        {
          "type": "faq_row"
        }
      ]
    }
  ]
}
{% endschema %} 
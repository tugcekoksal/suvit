{{ 'password-section.css' |  asset_url |  stylesheet_tag }}

<div class="page-width">
    <div class="main-password color-{{ section.settings.color_scheme_1 }} gradient">
        <div class="password__inner">
            <div class="center">
                <h2 class="title">{{ section.settings.heading }}</h2>
                <p class="subtitle-text_opacity">{{ section.settings.subheading }}</p>
            </div>
            <div class="password--layout">
                <div class="form_newslatter">
                    {%- form 'customer', id: 'newsletter-popup',  class: 'NewsletterPopup__Form' -%}
                    <div class="newsletter-form__field-wrapper newsletter_popup">
                    <div class="field">
                        <input type="hidden" name="contact[tags]" value="newsletter">
                        <input type="email" id="popup_email" name="contact[email]" class="field__input" required="required" aria-label="Email"  placeholder="Email" required>
                        <label class="field__label hidden" for="popup_email">{{ 'newsletter.email' | t }}</label>
                    </div>
                    <button type="submit" class="animated-button password_form--button button" name="commit" aria-label="{{ 'newsletter.button_label' | t }}">
                        <div><span>{{ 'newsletter.button_label' | t }}</span></div>
                    </button>
                    </div>
                    {%- if form.posted_successfully? -%}
                        <h3 class="newsletter-form__message newsletter-form__message--success form__message" id="ContactFooter-success" tabindex="-1" autofocus>
                        {%- render 'icon' with 'success' -%}
                            {{- 'newsletter.success' | t }}
                        </h3>
                        {%- endif -%}
                    {%- endform -%}
                </div>
                <h2 class="title center password__footer-login password__footer-text">{{ 'general.password_page.admin_link_html' | t }}</h2>
                <div class="main-password__login">
                    <a href="/admin" class="button password__button animated-button" title="{{ 'general.password_page.login_heare' | t }}"><div><span>{{ 'general.password_page.login_heare' | t }}</span></div></a>
                    <span class="password-contain__text">{{ 'general.password_page.or' | t }}</span>
                    <password-modal>
                        <details class="password-modal modal">
                            <summary class="modal__toggle" aria-haspopup="dialog">
                            <div class="modal__toggle-open password-link link">
                                {%- render 'icon' with 'padlock' -%}
                                {{ 'general.password_page.login_password_button' | t }}
                            </div>
                            <div class="modal__toggle-close" aria-hidden="true">
                                {%- render 'icon' with 'close' -%}
                            </div>
                            </summary>
                            <div class="modal__content" role="dialog" aria-labelledby="DialogHeading" aria-modal="true">
                            <div class="password-modal__content" tabindex="-1">
                                <button type="button" class="modal__close-button link" aria-label="{{ 'accessibility.close' | t }}">{%- render 'icon' with 'close' -%}</button>
                                <h2 class="password-modal__content-heading" id="DialogHeading">
                                {{ 'general.password_page.login_form_heading' | t }}
                                </h2>
                                {%- form 'storefront_password', class: 'password-form' -%}
                                <div class="password-field field{% if form.errors %} password-field--error{% endif %}">
                                    <input type="password" name="password" id="Password" class="field__input" autocomplete="current-password" {% if form.errors %} aria-invalid="true" aria-describedby="PasswordLoginForm-password-error"{%- endif -%} placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}">
                                    <label class="field__label" for="{{ 'general.password_page.login_form_password_label' | t }}">
                                    {{- 'general.password_page.login_form_password_placeholder' | t -}}
                                    </label>
                                    {%- if form.errors -%}
                                    <div id="PasswordLoginForm-password-error" role="status">
                                        <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                                        <span class="form__message">
                                        {%- render 'icon' with 'error' -%}
                                        {{ 'general.password_page.login_form_error' | t -}}
                                        </span>
                                    </div>
                                    {%- endif -%}
                                </div>
                                <button name="commit" class="password-button button animated-button">
                                    <div><span>{{ 'general.password_page.login_form_submit' | t }}</span></div>
                                </button>
                                {%- endform -%}
                                <p class="password__footer-text">{{ 'general.password_page.admin_link_html' | t }} <a href="/admin" class="link underline--link" title="{{ 'general.password_page.login_heare' | t }}">{{ 'general.password_page.login_heare' | t }}</a></p>
                            </div>
                            </div>
                        </details>
                    </password-modal>
                </div>
            </div>
        </div>
    </div>
</div>
{% schema %}
    {
        "name": "t:sections.main-password.name",
        "tag": "section",
        "class": "section",
        "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "t:sections.main-password.settings.heading.label",
            "default": "Opening soon"
        },
        {
            "type": "text",
            "id": "subheading",
            "label": "t:sections.main-password.settings.subheading.label",
            "default": "Be the first to know when we launch."
        },
        {
            "type": "color_scheme",
            "id": "color_scheme_1",
            "label": "t:sections.all.colors.label",
            "default": "scheme-1"
        }    
        ]
    }
{% endschema %}
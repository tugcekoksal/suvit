<section class="clickable-gallery-section">
  <div class="clickable-gallery-wrapper">
    {% if section.settings.heading != blank %}
      <h2 class="clickable-gallery-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="clickable-gallery-grid">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <button
            class="clickable-gallery-item"
            type="button"
            data-full-image="{{ block.settings.image | image_url: width: 2400 }}"
            {{ block.shopify_attributes }}
          >
           <img
  src="{{ block.settings.image | image_url: width: 800 }}"
  width="{{ block.settings.image.width }}"
  height="{{ block.settings.image.height }}"
  alt="{{ block.settings.image.alt | escape }}"
  loading="lazy"
>
          </button>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  <div class="clickable-gallery-modal" aria-hidden="true">
    <button class="clickable-gallery-close" type="button" aria-label="Close">×</button>
    <img
  class="clickable-gallery-modal-image"
  src=""
  width="1200"
  height="675"
  alt=""
>
  </div>
</section>

<style>
  .clickable-gallery-section {
    padding: {{ section.settings.section_padding }}px 20px;
  }

  .clickable-gallery-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  .clickable-gallery-heading {
    text-align: center;
    margin-bottom: 32px;
    font-size: 32px;
  }

  .clickable-gallery-grid {
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.gap }}px;
  }

  .clickable-gallery-item {
    border: none;
    padding: 0;
    background: transparent;
    cursor: pointer;
    overflow: hidden;
    border-radius: {{ section.settings.border_radius }}px;
    aspect-ratio: 1842 / 1328;
  }

  .clickable-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .clickable-gallery-item:hover img {
    transform: scale(1.05);
  }

  .clickable-gallery-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.88);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .clickable-gallery-modal.is-active {
    display: flex;
  }

  .clickable-gallery-modal-image {
    max-width: 95%;
    max-height: 90vh;
    object-fit: contain;
    border-radius: {{ section.settings.border_radius }}px;
  }

  .clickable-gallery-close {
    position: absolute;
    top: 20px;
    right: 28px;
    background: transparent;
    color: #ffffff;
    border: none;
    font-size: 44px;
    cursor: pointer;
    line-height: 1;
  }

  @media screen and (max-width: 989px) {
    .clickable-gallery-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .clickable-gallery-grid {
      grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    }

    .clickable-gallery-heading {
      font-size: 26px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const galleries = document.querySelectorAll('.clickable-gallery-section');

    galleries.forEach(function (gallery) {
      const items = gallery.querySelectorAll('.clickable-gallery-item');
      const modal = gallery.querySelector('.clickable-gallery-modal');
      const modalImage = gallery.querySelector('.clickable-gallery-modal-image');
      const closeButton = gallery.querySelector('.clickable-gallery-close');

      items.forEach(function (item) {
        item.addEventListener('click', function () {
          const fullImage = item.dataset.fullImage;

          modalImage.src = fullImage;
          modal.classList.add('is-active');
          modal.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        });
      });

      function closeModal() {
        modal.classList.remove('is-active');
        modal.setAttribute('aria-hidden', 'true');
        modalImage.src = '';
        document.body.style.overflow = '';
      }

      closeButton.addEventListener('click', closeModal);

      modal.addEventListener('click', function (event) {
        if (event.target === modal) {
          closeModal();
        }
      });

      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && modal.classList.contains('is-active')) {
          closeModal();
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Clickable Image Gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Gallery"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Images per row on desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "label": "Images per row on tablet",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Images per row on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between images",
      "min": 4,
      "max": 40,
      "step": 2,
      "default": 16
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Gallery max width",
      "min": 600,
      "max": 1800,
      "step": 50,
      "default": 1200
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section vertical padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 40
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Image border radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "Clickable Image Gallery"
    }
  ]
}
{% endschema %}
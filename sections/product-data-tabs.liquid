{%- comment -%}
  Section: Product Tabs (Desktop) + Mobile Accordions

  Desktop:
    - Tabs (Beschreibung / Technische Daten / Herstellerangaben / Dokumente)
    - Empty sections are hidden automatically

  Mobile:
    - Accordions
    - Empty sections are hidden automatically

  Metafields used:
   - product.description
   - product.metafields.custom.technische_daten
   - product.metafields.custom.technische_daten_heizung
   - product.metafields.custom.manufacturer
   - product.metafields.custom.documents
{%- endcomment -%}

{% assign tech_list = product.metafields.custom.technische_daten.value %}
{% assign manufacturer = product.metafields.custom.manufacturer.value %}
{% assign docs = product.metafields.custom.documents.value %}
{% assign tech_heizung_list = product.metafields.custom.technische_daten_heizung.value %}

{% assign has_tech_data = false %}
{% if tech_list != blank or tech_heizung_list != blank %}
  {% assign has_tech_data = true %}
{% endif %}

{% assign has_manufacturer = false %}
{% if manufacturer != blank %}
  {% assign has_manufacturer = true %}
{% endif %}

{% assign has_docs = false %}
{% if docs != blank %}
  {% assign has_docs = true %}
{% endif %}

{%- capture technical_data_rows -%}
  {% for entry in tech_list %}
    {% if entry.product %}
      <tr><th>Product</th><td>{{ entry.product }}</td></tr>
    {% endif %}

    {% if entry.material %}
      <tr><th>Material</th><td>{{ entry.material }}</td></tr>
    {% endif %}

    {% if entry.farben %}
      <tr><th>Farben</th><td>{{ entry.farben }}</td></tr>
    {% endif %}

    {% if entry.breite %}
      <tr><th>Breite</th><td>{{ entry.breite | metafield_text }}</td></tr>
    {% endif %}

    {% if entry.breiten %}
      <tr><th>Breiten</th><td>{{ entry.breiten }}</td></tr>
    {% endif %}

    {% if entry.produktabmessungen %}
      <tr><th>Produktabmessungen</th><td>{{ entry.produktabmessungen }}</td></tr>
    {% endif %}

    {% if entry.hohe %}
      <tr><th>Höhe</th><td>{{ entry.hohe | metafield_text }}</td></tr>
    {% endif %}

    {% if entry.tiefe %}
      <tr><th>Tiefe</th><td>{{ entry.tiefe | metafield_text }}</td></tr>
    {% endif %}

    {% if entry.art %}
      <tr><th>Art</th><td>{{ entry.art }}</td></tr>
    {% endif %}

    {% if entry.gewicht %}
      <tr><th>Gewicht</th><td>{{ entry.gewicht | metafield_text }}</td></tr>
    {% endif %}

    {% if entry.montageart %}
      <tr><th>Montageart</th><td>{{ entry.montageart }}</td></tr>
    {% endif %}

    {% if entry.form %}
      <tr><th>Form</th><td>{{ entry.form }}</td></tr>
    {% endif %}

    {% if entry.modell %}
      <tr><th>Modell</th><td>{{ entry.modell }}</td></tr>
    {% endif %}

    {% if entry.integriertes_bidet %}
      <tr><th>Integriertes Bidet</th><td>{{ entry.integriertes_bidet }}</td></tr>
    {% endif %}

    {% if entry.tragkraft_schubladen %}
      <tr><th>Tragkraft Schubladen</th><td>{{ entry.tragkraft_schubladen }}</td></tr>
    {% endif %}

    {% if entry.tragkraft_wandmontage %}
      <tr><th>Tragkraft Wandmontage</th><td>{{ entry.tragkraft_wandmontage }}</td></tr>
    {% endif %}

    {% if entry.spulmenge %}
      <tr><th>Spülmenge</th><td>{{ entry.spulmenge }}</td></tr>
    {% endif %}

    {% if entry.spulbetatigung %}
      <tr><th>Spülbetätigung</th><td>{{ entry.spulbetatigung }}</td></tr>
    {% endif %}

    {% if entry.armatur %}
      <tr><th>Armatur</th><td>{{ entry.armatur }}</td></tr>
    {% endif %}

    {% if entry.wc_sitz %}
      <tr><th>WC-Sitz</th><td>{{ entry.wc_sitz }}</td></tr>
    {% endif %}

    {% if entry.betatigungsplatte %}
      <tr><th>Betätigungsplatte</th><td>{{ entry.betatigungsplatte }}</td></tr>
    {% endif %}

    {% if entry.schutzklasse_led %}
      <tr><th>Schutzklasse LED</th><td>{{ entry.schutzklasse_led }}</td></tr>
    {% endif %}

    {% if entry.einsatzorte %}
      <tr><th>Einsatzorte</th><td>{{ entry.einsatzorte }}</td></tr>
    {% endif %}

    {% if entry.tragfahigkeit %}
      <tr><th>Tragfähigkeit</th><td>{{ entry.tragfahigkeit }}</td></tr>
    {% endif %}

    {% if entry.oberflache %}
      <tr><th>Oberfläche</th><td>{{ entry.oberflache }}</td></tr>
    {% endif %}

    {% if entry.einsatzbereich %}
      <tr><th>Einsatzbereich</th><td>{{ entry.einsatzbereich }}</td></tr>
    {% endif %}

    {% if entry.kompatibilitat %}
      <tr><th>Kompatibilität</th><td>{{ entry.kompatibilitat }}</td></tr>
    {% endif %}

    {% if entry.norm %}
      <tr><th>Norm</th><td>{{ entry.norm }}</td></tr>
    {% endif %}

    {% if entry.hersteller %}
      <tr><th>Hersteller</th><td>{{ entry.hersteller }}</td></tr>
    {% endif %}

    {% if entry.modellnummer %}
      <tr><th>Modellnummer</th><td>{{ entry.modellnummer }}</td></tr>
    {% endif %}

    {% if entry.lieferumfang %}
      <tr><th>Lieferumfang</th><td>{{ entry.lieferumfang }}</td></tr>
    {% endif %}

    {% if entry.normen_prufungen %}
      <tr><th>Normen / Prüfungen</th><td>{{ entry.normen_prufungen }}</td></tr>
    {% endif %}

    {% if entry.druckprufung %}
      <tr><th>Druckprüfung</th><td>{{ entry.druckprufung }}</td></tr>
    {% endif %}

    {% if entry.eigenschaften %}
      <tr><th>Eigenschaften</th><td>{{ entry.eigenschaften }}</td></tr>
    {% endif %}

    {% if entry.marke %}
      <tr><th>Marke</th><td>{{ entry.marke }}</td></tr>
    {% endif %}

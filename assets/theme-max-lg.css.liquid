@charset "UTF-8";
@media screen and (max-width: 1023px) {
  .header-top {
    padding-left: 0;
    padding-right: 0;
  }
}
@media (max-width: 1023px) {
  .block-text-button__wrapper:hover .block-text-button-text-effect-1,
  .block-text-button__wrapper:focus .block-text-button-text-effect-1,
  .block-text-button__wrapper:active .block-text-button-text-effect-1{
    --tw-translate-y: 0px;
    transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));
    transition-property: none;
  }

  .block-text-button__wrapper:hover .block-text-button-text-effect-2,
  .block-text-button__wrapper:focus .block-text-button-text-effect-2,
  .block-text-button__wrapper:active .block-text-button-text-effect-2{
    --tw-translate-y: 110%;
    transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));
    transition-property: none;
  }
}
@media (max-width: 1023px) {
  .tab-animation-underline .tabs__button-horizontal:hover .block-text-button-text-effect-1,.tab-animation-underline .tabs__button-horizontal:focus .block-text-button-text-effect-1,.tab-animation-underline .tabs__button-horizontal:active .block-text-button-text-effect-1{
    --tw-translate-y: 0px;
    transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));
    transition-property: none;
  }

  .tab-animation-underline .tabs__button-horizontal:hover .block-text-button-text-effect-2,.tab-animation-underline .tabs__button-horizontal:focus .block-text-button-text-effect-2,.tab-animation-underline .tabs__button-horizontal:active .block-text-button-text-effect-2{
    --tw-translate-y: 110%;
    transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));
    transition-property: none;
  }
}
@media (max-width: 1023px){
  .max-lg\:left-0{
    left: 0px;
  }
  .max-lg\:right-auto{
    right: auto;
  }
  .max-lg\:top-0{
    top: 0px;
  }
  .max-lg\:mb-3{
    margin-bottom: 0.75rem;
  }
  .max-lg\:mb-\[var\(--spacing-between-heading-and-content\)\]{
    margin-bottom: var(--spacing-between-heading-and-content);
  }
  .max-lg\:h-full{
    height: 100%;
  }
  .max-lg\:w-full{
    width: 100%;
  }
  .max-lg\:transition-none{
    transition-property: none;
  }
}
@media (max-width: 1023px){
  .ltr\:max-lg\:pr-3:where([dir="ltr"], [dir="ltr"] *){
    padding-right: 0.75rem;
  }
}

  z-index: 5;
  cursor: pointer;
  border-radius: 100%;
  transform: scale(1);
  transition: all .4s;
}
.arrow-dows .scroll_Top svg{
  transform: rotate(180deg);
  width: 1.5rem;
  height: 1.5rem;
}
.animated-button {
  overflow: hidden;
}
.tech-data-table {
  width: 100%;
  border-collapse: collapse;
  margin-top: 15px;
  font-size: 14px;
}

.tech-data-table th {
  text-align: left;
  padding: 8px 12px;
  background-color: #f7f7f7;
  font-weight: 600;
  border: 1px solid #e5e5e5;
}

.tech-data-table td {
  padding: 8px 12px;
  border: 1px solid #e5e5e5;

}
/* FORCE: product cards show full image (no crop) */
.product-card-wrapper .card__media img,
.product_card .card__media img,
.card-wrapper .card__media img,
.card__media img {
  width: 100% !important;
  height: 100% !important;
  object-fit: contain !important;
}
/* === PRODUCT MODAL RESET + VERTICAL IMAGE LAYOUT === */

.product-media-modal {
  overflow-y: auto;
  overflow-x: hidden;
}

.product-media-modal__dialog {
  display: block;
  width: 100%;
  max-width: 100%;
  height: 100%;
}

.product-media-modal__content {
  display: block;
  padding: 0;
  overflow: visible;
}

.product-media-modal__content > * {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  width: 100%;
  box-sizing: border-box;
  padding: 20px;
}

.product-media-modal__content img {
  display: block;
  max-width: 100%;
  max-height: calc(100vh - 40px);
  width: auto;
  height: auto;
  margin: 0 auto;
  object-fit: contain;
}

@media screen and (max-width: 749px) {
  .product-media-modal__content > * {
    min-height: 100vh;
    padding: 12px;
  }

  .product-media-modal__content img {
    max-width: 100%;
    max-height: calc(100vh - 24px);
  }
}
.free-shipping-box {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 16px 0;
  padding: 14px 18px;
  border-radius: 12px;
  background: linear-gradient(135deg, #e8fff1, #f4fff8);
  border: 1px solid #8ed8a8;
  color: #137333;
  box-shadow: 0 6px 18px rgba(19, 115, 51, 0.08);
}

.free-shipping-icon {
  font-size: 20px;
  line-height: 1;
}

.free-shipping-title {
  font-weight: 700;
  font-size: 16px;
  line-height: 1.2;
}

.free-shipping-subtitle {
  font-size: 13px;
  margin-top: 2px;
  opacity: 0.85;
  line-height: 1.3;
}
@media screen and (max-width: 749px) {
  .product-media-modal__dialog {
    display: flex;
    flex-direction: column;
    height: 100dvh;
    overflow: hidden;
  }

  .product-media-modal__content--slider {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;
    align-items: center;
    width: 100%;
    height: 100%;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-behavior: smooth;
  }

  .product-media-modal__content--slider::-webkit-scrollbar {
    display: none;
  }

  .product-media-modal__content--slider > * {
    flex: 0 0 100% !important;
    width: 100% !important;
    min-width: 100% !important;
    max-width: 100% !important;
    height: 100% !important;
    display: flex !important;
    align-items: center;
    justify-content: center;
    scroll-snap-align: start;
    position: relative !important;
    margin: 0 !important;
    transform: none !important;
  }

  .product-media-modal__content--slider img,
  .product-media-modal__content--slider video,
  .product-media-modal__content--slider iframe,
  .product-media-modal__content--slider model-viewer,
  .product-media-modal__content--slider .media,
  .product-media-modal__content--slider .product-media-container,
  .product-media-modal__content--slider .deferred-media {
    max-width: 100%;
    width: 100%;
    height: auto;
    max-height: calc(100dvh - 24px);
    object-fit: contain;
  }
}
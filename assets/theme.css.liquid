.header__icons .link--text--hover:hover:after{
  bottom: 10px;
}
@media screen and (min-width: 445px) and (max-width: 550px) {
  .header__icon__style-text.header__icons{
    gap: 0.5rem
  }
}
.header__icon:not(.header__icon--summary), .header__icon span {
  display: flex;
  align-items: center;
  justify-content: center;
}
.header__icon .user_icon-text{
  font-size: 1.4rem
} 
.header__icon {
  color: rgb(var(--color-foreground));
}
.header__icon span {
  height: 100%;
  font-size: 10px;
}
.cart-count-bubble span {
  white-space: nowrap;
}
.header__icon::after {

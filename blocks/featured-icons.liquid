{% style %}
  .block-{{ block.id }} {
    --pad-top: {{ block.settings.desktop_padding_top }}px;
    --pad-bottom: {{ block.settings.desktop_padding_bottom }}px;
    --pad-left: {{ block.settings.desktop_padding_left }}px;
    --pad-right: {{ block.settings.desktop_padding_right }}px;
    --pad-top-m: {{ block.settings.mobile_padding_top }}px;
    --pad-bottom-m: {{ block.settings.mobile_padding_bottom }}px;
    --pad-left-m: {{ block.settings.mobile_padding_left }}px;
    --pad-right-m: {{ block.settings.mobile_padding_right }}px;
  }
{% endstyle %}

{% liquid
  assign is_grid_on_desktop = true
  assign is_grid_on_mobile = true
  if block.settings.display_type_desktop == 'rotating'
    assign is_grid_on_desktop = false
  endif

  if block.settings.display_type_mobile == 'rotating'
    assign is_grid_on_mobile = false
  endif
%}

<div
  class="block-featured-icons block-padding maximize-block block-{{ block.id }} w-full rounded-corners color-{{ block.settings.color_scheme_light }} dark-color-{{ block.settings.color_scheme_dark }}"
  data-block-id="{{ block.id }}"
  {{ block.shopify_attributes }}
>
  {% if is_grid_on_mobile == false or is_grid_on_desktop == false %}
    {%- capture slide_element_config -%}
      { "timeToNext": {{ block.settings.auto_rotate_every }} }
    {%- endcapture -%}
    <slide-element 
      class="featured-icons__wrapper slide-element w-full relative has-[.icon-with-text-content-visible:hover]:z-30"
      data-config='{{ slide_element_config }}'
      data-animation="{{ block.settings.animation }}"
      data-is-grid-on-desktop="{% if is_grid_on_desktop %}true{% else %}false{% endif %}"
      data-is-grid-on-mobile="{% if is_grid_on_mobile %}true{% else %}false{% endif %}"
    >
  {% else %}
    <div class="featured-icons__wrapper w-full relative">
  {% endif %}
      <div 
        class="slide-element__list-items w-full grid
          {%- if is_grid_on_mobile %} grid-cols-{{ block.settings.column_layout_mobile }} gap-2.5{%- else %} grid-cols-1{% endif -%}
          {%- if is_grid_on_desktop %} md:grid-cols-{{ block.settings.column_layout_tablet }} lg:grid-cols-{{ block.settings.column_layout_desktop }} md:gap-2.5{% else %} md:grid-cols-1{% endif -%}
        "
      >
        {% content_for 'blocks' %}
      </div>
  {% if is_grid_on_mobile == false or is_grid_on_desktop == false %}
    </slide-element>
  {% else %}
    </div>
  {% endif %}
</div>


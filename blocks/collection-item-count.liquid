{% liquid
  assign collection = closest.collection
  assign count = collection.products_count | default: 0

  assign prefix = block.settings.prefix_text | strip
  assign suffix = ''
  if count <= 1
    assign suffix = block.settings.suffix_text_singular | strip
  else
    assign suffix = block.settings.suffix_text_plural | strip
  endif

  assign display_text = prefix
  unless prefix == blank
    assign display_text = display_text | append: ' '
  endunless
  assign display_text = display_text | append: count
  unless suffix == blank
    assign display_text = display_text | append: ' '
    assign display_text = display_text | append: suffix
  endunless

  assign font_size_class = 'font-base-body text-' | append: block.settings.font_size
%}

{% if collection and display_text != blank %}
  {% style %}
    .block-{{ block.id }} {
      --pad-top: {{ block.settings.desktop_padding_top }}px;
      --pad-bottom: {{ block.settings.desktop_padding_bottom }}px;
      --pad-left: {{ block.settings.desktop_padding_left }}px;
      --pad-right: {{ block.settings.desktop_padding_right }}px;
      --pad-top-m: {{ block.settings.mobile_padding_top }}px;
      --pad-bottom-m: {{ block.settings.mobile_padding_bottom }}px;
      --pad-left-m: {{ block.settings.mobile_padding_left }}px;
      --pad-right-m: {{ block.settings.mobile_padding_right }}px;
    }

    {% if block.settings.font_size == 'custom' %}
      .block-{{ block.id }} {
        font-size: {{ block.settings.mobile_font_size }}px;
        line-height: {{ block.settings.line_height }}%;
      }
      @media (min-width: 768px) {
        .block-{{ block.id }} {
          font-size: {{ block.settings.desktop_font_size }}px;
          line-height: {{ block.settings.line_height }}%;
        }
      }
    {% endif %}

    {% if block.settings.text_color_light.alpha > 0 %}
      .maximize-theme:not(.dark) .block-collection-count.block-{{ block.id }} {
        color: rgba({{ block.settings.text_color_light.red }} {{ block.settings.text_color_light.green }} {{ block.settings.text_color_light.blue }} / {{ block.settings.text_color_light.alpha }});
      }
    {% endif %}

    {% if block.settings.text_color_dark.alpha > 0 %}
      .maximize-theme.dark .block-collection-count.block-{{ block.id }} {
        color: rgba({{ block.settings.text_color_dark.red }} {{ block.settings.text_color_dark.green }} {{ block.settings.text_color_dark.blue }} / {{ block.settings.text_color_dark.alpha }});
      }
    {% endif %}
  {% endstyle %}

  <p
    class="maximize-block block-collection-count block-padding transition duration-200 anm-fade-element text-animation-item block-{{ block.id }} p-break-words {{ font_size_class }}"
    data-block-id="{{ block.id }}"
    {{ block.shopify_attributes }}
  >
    {{ display_text }}
  </p>
{% endif %}

{% schema %}
{
  "name": "Collection item count",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "prefix_text",
      "label": "Prefix text",
      "info": "Text displayed before the number. Leave empty for none."
    },
    {
      "type": "text",
      "id": "suffix_text_singular",
      "label": "Suffix (singular)",
      "info": "Used when count = 1. E.g: \" product\".",
      "default": "product"
    },
    {
      "type": "text",
      "id": "suffix_text_plural",
      "label": "Suffix (plural)",
      "info": "Used when count ≠ 1. E.g: \" products\".",
      "default": "products"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "font_size",
      "label": "Font size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "small"
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop font size",
      "default": 14,
      "visible_if": "{{ block.settings.font_size == 'custom' }}"
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile font size",
      "default": 14,
      "visible_if": "{{ block.settings.font_size == 'custom' }}"
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 100,
      "max": 300,
      "step": 5,
      "unit": "%",
      "label": "Line height",
      "default": 140,
      "visible_if": "{{ block.settings.font_size == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "select",
      "id": "spacing_choose_device",
      "label": "Choose device",
      "options": [
        {
          "value": "desktop",
          "label": "Desktop"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        }
      ],
      "default": "desktop",
      "info": "Desktop and Mobile settings are configured separately."
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Left",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "desktop_padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Right",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Left",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Right",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "text_color_light",
      "default": "rgba(0,0,0,0)",
      "label": "Text color (light)"
    },
    {
      "type": "color",
      "id": "text_color_dark",
      "default": "rgba(0,0,0,0)",
      "label": "Text color (dark)"
    }
  ],
  "presets": [
    {
      "name": "Collection item count"
    }
  ]
}
{% endschema %}

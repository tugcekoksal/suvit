{
  "name": "Product tabs",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Tab labels"
    },
    {
      "type": "text",
      "id": "description_tab_label",
      "label": "Description tab label",
      "default": "Beschreibung"
    },
    {
      "type": "text",
      "id": "technical_tab_label",
      "label": "Technical data tab label",
      "default": "Technische Daten"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Section padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 40,

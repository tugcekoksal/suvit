{% doc %}
  @prompt
    Create a Shopify custom product section with two tabs: the first tab displays the product description using {{ product.description }} (rendered as HTML), and the second tab displays “Technische Daten” sourced from the product metafield custom.technische_daten, which is a list of metaobject references of type technische_daten. In the technical data tab, loop through product.metafields.custom.technische_daten.value, then for each metaobject entry dynamically iterate over all its fields, rendering only non-empty fields as a list (<ul><li>), showing the human-readable field label and its value without hardcoding field names or parsing text. Handle field types correctly: render text fields normally and dimension fields (e.g. width, height, depth, weight) using metafield_tag or metafield_text so units display properly. Do not assume the metafield is text, do not use “Label: Value” parsing, and implement basic tab switching inside the section with the Description tab active by default., technische data should have those :{% if product.metafields.custom.technische_daten.value %}
      <table class="tech-data-table">
        <tbody>
          {% for entry in product.metafields.custom.technische_daten.value %}
            
            {% if entry.product %}
              <tr>
                <th>Product</th>
                <td>{{ entry.product }}</td>
              </tr>
            {% endif %}
    
            {% if entry.material %}
              <tr>
                <th>Material</th>
                <td>{{ entry.material }}</td>
              </tr>
            {% endif %}
    
       
    
            {% if entry.farben %}
              <tr>
                <th>Farben</th>
                <td>{{ entry.farben }}</td>
              </tr>
            {% endif %}
    
            {% if entry.breite %}
              <tr>
                <th>Breite</th>
                <td>{{ entry.breite | metafield_text }}</td>
              </tr>
            {% endif %}
    
            {% if entry.breiten %}
              <tr>
                <th>Breiten</th>
                <td>{{ entry.breiten }}</td>
              </tr>
            {% endif %}
     {% if entry.produktabmessungen%}
              <tr>
                <th> Produktabmessungen</th>
                <td>{{ entry.produktabmessungen }}</td>
              </tr>
            {% endif %}
    
            {% if entry.hohe %}
              <tr>
                <th>Höhe</th>
                <td>{{ entry.hohe | metafield_text }}</td>
              </tr>
            {% endif %}
    
            {% if entry.tiefe %}
              <tr>
                <th>Tiefe</th>
                <td>{{ entry.tiefe | metafield_text }}</td>
              </tr>
            {% endif %}
    
            {% if entry.art %}
              <tr>
                <th>Art</th>
                <td>{{ entry.art }}</td>
              </tr>
            {% endif %}
    
            {% if entry.gewicht %}
              <tr>
                <th>Gewicht</th>
                <td>{{ entry.gewicht | metafield_text }}</td>
              </tr>
            {% endif %}
    
            {% if entry.montageart %}
              <tr>
                <th>Montageart</th>
                <td>{{ entry.montageart }}</td>
              </tr>
            {% endif %}
    
            {% if entr, add those as well: {% if entry.form %}
              <tr>
                <th>Form</th>
                <td>{{ entry.form }}</td>
              </tr>
            {% endif %}
    
            {% if entry.modell %}
              <tr>
                <th>Modell</th>

      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Content font size",
      "default": 14
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "active_tab_color",
      "label": "Active tab color",
      "default": "#353535"
    },
    {
      "type": "color",
      "id": "inactive_tab_color",
      "label": "Inactive tab color",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#353535"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    }
  ],
  "presets": [
    {
      "name": "Product tabs"
    }
  ]
}
{% endschema %}

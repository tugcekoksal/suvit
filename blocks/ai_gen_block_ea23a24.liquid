{% doc %}
  @prompt
    image gallery, can you show only the loaded images? when an image is not loaded i shouldnt see the placeholder neither
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-gallery-{{ ai_gen_id }} {
    width: 100%;
    max-width: 100%;
  }

  .ai-image-gallery__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: 32px;
  }

  .ai-image-gallery__title-{{ ai_gen_id }} {
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 16px;
    font-weight: 600;
  }

  .ai-image-gallery__description-{{ ai_gen_id }} {
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: {{ settings.body_font_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-image-gallery__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ settings.spacing_grid_horizontal }}px {{ settings.spacing_grid_vertical }}px;
    margin-bottom: 0;
  }

  .ai-image-gallery__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ settings.media_radius }}px;
    background-color: #f4f4f4;
    aspect-ratio: {{ block.settings.aspect_ratio }};
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .ai-image-gallery__item-{{ ai_gen_id }}:hover {
    {% if settings.animations_hover_elements == 'scale' %}
      transform: scale(1.02);
    {% endif %}
  }

  .ai-image-gallery__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-image-gallery__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: 2;
  }

  .ai-image-gallery__item-{{ ai_gen_id }}:hover .ai-image-gallery__overlay-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-image-gallery__zoom-icon-{{ ai_gen_id }} {
    width: 32px;
    height: 32px;
    color: white;
  }

  .ai-image-gallery__lightbox-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .ai-image-gallery__lightbox-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-image-gallery__lightbox-content-{{ ai_gen_id }} {
    position: relative;
    max-width: 90vw;
    max-height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-image-gallery__lightbox-image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: {{ settings.media_radius }}px;
  }

  .ai-image-gallery__lightbox-close-{{ ai_gen_id }} {
    position: absolute;
    top: -50px;
    right: 0;
    background: none;
    border: none;
    color: white;
    cursor: pointer;
    padding: 10px;
    font-size: 24px;
    z-index: 10000;
  }

  .ai-image-gallery__lightbox-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.1);
    border: none;
    color: white;
    cursor: pointer;
    padding: 15px;
    border-radius: 50%;
    font-size: 20px;
    transition: background-color 0.3s ease;
    z-index: 10000;
  }

  .ai-image-gallery__lightbox-nav-{{ ai_gen_id }}:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .ai-image-gallery__lightbox-prev-{{ ai_gen_id }} {
    left: -60px;
  }

  .ai-image-gallery__lightbox-next-{{ ai_gen_id }} {
    right: -60px;
  }

  .ai-image-gallery__lightbox-counter-{{ ai_gen_id }} {
    position: absolute;
    bottom: -50px;
    left: 50%;
    transform: translateX(-50%);
    color: white;
    font-size: 14px;
    background: rgba(0, 0, 0, 0.5);
    padding: 8px 16px;
    border-radius: 20px;
  }

  .ai-image-gallery__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    font-size: 16px;
  }

  .ai-image-gallery__empty-state-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    margin-bottom: 16px;
    opacity: 0.3;
  }

  @media screen and (max-width: 749px) {
    .ai-image-gallery__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
    }

    .ai-image-gallery__lightbox-nav-{{ ai_gen_id }} {
      position: fixed;
      top: auto;
      bottom: 20px;
      transform: none;
    }

    .ai-image-gallery__lightbox-prev-{{ ai_gen_id }} {
      left: 20px;
    }

    .ai-image-gallery__lightbox-next-{{ ai_gen_id }} {
      right: 20px;
    }

    .ai-image-gallery__lightbox-close-{{ ai_gen_id }} {
      top: 20px;
      right: 20px;
    }

    .ai-image-gallery__lightbox-counter-{{ ai_gen_id }} {
      bottom: 80px;
    }
  }
{% endstyle %}

<image-gallery-{{ ai_gen_id }}
  class="ai-image-gallery-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank or block.settings.description != blank %}
    <div class="ai-image-gallery__header-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-image-gallery__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      {% if block.settings.description != blank %}
        <div class="ai-image-gallery__description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
      {% endif %}
    </div>
  {% endif %}

  {% liquid
    assign has_images = false
    for i in (1..8)
      assign image_key = 'image_' | append: i
      assign image = block.settings[image_key]
      if image != blank
        assign has_images = true
        break
      endif
    endfor
  %}

  {% if has_images %}
    <div class="ai-image-gallery__grid-{{ ai_gen_id }}">
      {% for i in (1..8) %}
        {% liquid
          assign image_key = 'image_' | append: i
          assign image = block.settings[image_key]
        %}
        
        {% if image != blank %}
          <div 
            class="ai-image-gallery__item-{{ ai_gen_id }}"
            data-image-index="{{ forloop.index0 }}"
            role="button"
            tabindex="0"
            aria-label="View image {{ forloop.index }} in lightbox"
          >
            <img
              src="{{ image | image_url: width: 800 }}"
              alt="{{ image.alt | escape }}"
              class="ai-image-gallery__image-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ image.width }}"
              height="{{ image.height }}"
            >
            <div class="ai-image-gallery__overlay-{{ ai_gen_id }}">
              <svg class="ai-image-gallery__zoom-icon-{{ ai_gen_id }}" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
              </svg>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-image-gallery__empty-state-{{ ai_gen_id }}">
      {{ 'image' | placeholder_svg_tag }}
      <p>Add images to create your gallery</p>
    </div>
  {% endif %}

  <div class="ai-image-gallery__lightbox-{{ ai_gen_id }}" role="dialog" aria-modal="true" aria-label="Image gallery lightbox">
    <div class="ai-image-gallery__lightbox-content-{{ ai_gen_id }}">
      <button 
        class="ai-image-gallery__lightbox-close-{{ ai_gen_id }}"
        aria-label="Close lightbox"
      >
        <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
      
      <button 
        class="ai-image-gallery__lightbox-nav-{{ ai_gen_id }} ai-image-gallery__lightbox-prev-{{ ai_gen_id }}"
        aria-label="Previous image"
      >
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      
      <img 
        class="ai-image-gallery__lightbox-image-{{ ai_gen_id }}"
        src=""
        alt=""
      >
      
      <button 
        class="ai-image-gallery__lightbox-nav-{{ ai_gen_id }} ai-image-gallery__lightbox-next-{{ ai_gen_id }}"
        aria-label="Next image"
      >
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>
      
      <div class="ai-image-gallery__lightbox-counter-{{ ai_gen_id }}">
        <span class="current">1</span> / <span class="total">1</span>
      </div>
    </div>
  </div>
</image-gallery-{{ ai_gen_id }}>

<script>
  (function() {
    class ImageGallery{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.images = [];
        this.currentIndex = 0;
      }

      connectedCallback() {
        this.setupGallery();
        this.setupLightbox();
        this.setupEventListeners();
      }

      setupGallery() {
        const imageItems = this.querySelectorAll('.ai-image-gallery__item-{{ ai_gen_id }}');
        this.images = Array.from(imageItems)
          .map((item, index) => {
            const img = item.querySelector('.ai-image-gallery__image-{{ ai_gen_id }}');
            return img ? {
              src: img.src.replace(/width=\d+/, 'width=1200'),
              alt: img.alt,
              element: item,
              originalIndex: index
            } : null;
          })
          .filter(Boolean);

        this.images.forEach((image, index) => {
          image.element.setAttribute('data-image-index', index);
        });
      }

      setupLightbox() {
        this.lightbox = this.querySelector('.ai-image-gallery__lightbox-{{ ai_gen_id }}');
        this.lightboxImage = this.querySelector('.ai-image-gallery__lightbox-image-{{ ai_gen_id }}');
        this.closeBtn = this.querySelector('.ai-image-gallery__lightbox-close-{{ ai_gen_id }}');
        this.prevBtn = this.querySelector('.ai-image-gallery__lightbox-prev-{{ ai_gen_id }}');
        this.nextBtn = this.querySelector('.ai-image-gallery__lightbox-next-{{ ai_gen_id }}');
        this.counter = this.querySelector('.ai-image-gallery__lightbox-counter-{{ ai_gen_id }}');
      }

      setupEventListeners() {
        this.images.forEach((image, index) => {
          image.element.addEventListener('click', () => this.openLightbox(index));
          image.element.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              this.openLightbox(index);
            }
          });
        });

        if (this.closeBtn) {
          this.closeBtn.addEventListener('click', () => this.closeLightbox());
        }
        
        if (this.prevBtn) {
          this.prevBtn.addEventListener('click', () => this.showPrevious());
        }
        
        if (this.nextBtn) {
          this.nextBtn.addEventListener('click', () => this.showNext());
        }

        if (this.lightbox) {
          this.lightbox.addEventListener('click', (e) => {
            if (e.target === this.lightbox) {
              this.closeLightbox();
            }
          });
        }

        document.addEventListener('keydown', (e) => {
          if (!this.lightbox || !this.lightbox.classList.contains('active')) return;
          
          switch(e.key) {
            case 'Escape':
              this.closeLightbox();
              break;
            case 'ArrowLeft':
              this.showPrevious();
              break;
            case 'ArrowRight':
              this.showNext();
              break;
          }
        });
      }

      openLightbox(index) {
        if (this.images.length === 0) return;
        
        this.currentIndex = index;
        this.updateLightboxImage();
        this.lightbox.classList.add('active');
        document.body.style.overflow = 'hidden';
        this.lightboxImage.focus();
      }

      closeLightbox() {
        this.lightbox.classList.remove('active');
        document.body.style.overflow = '';
        if (this.images[this.currentIndex]) {
          this.images[this.currentIndex].element.focus();
        }
      }

      showPrevious() {
        this.currentIndex = this.currentIndex > 0 ? this.currentIndex - 1 : this.images.length - 1;
        this.updateLightboxImage();
      }

      showNext() {
        this.currentIndex = this.currentIndex < this.images.length - 1 ? this.currentIndex + 1 : 0;
        this.updateLightboxImage();
      }

      updateLightboxImage() {
        if (this.images.length === 0) return;
        
        const image = this.images[this.currentIndex];
        this.lightboxImage.src = image.src;
        this.lightboxImage.alt = image.alt;
        
        this.counter.querySelector('.current').textContent = this.currentIndex + 1;
        this.counter.querySelector('.total').textContent = this.images.length;

        this.prevBtn.style.display = this.images.length > 1 ? 'block' : 'none';
        this.nextBtn.style.display = this.images.length > 1 ? 'block' : 'none';
      }
    }

    customElements.define('image-gallery-{{ ai_gen_id }}', ImageGallery{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Image gallery",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Image Gallery"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore our collection of beautiful images</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns on desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1/1",
          "label": "Square (1:1)"
        },
        {
          "value": "4/3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "3/4",
          "label": "Portrait (3:4)"
        },
        {
          "value": "16/9",
          "label": "Widescreen (16:9)"
        },
        {
          "value": "auto",
          "label": "Original"
        }
      ],
      "default": "1/1"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#353535"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#353535"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Image 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Image 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Image 6"
    },
    {
      "type": "image_picker",
      "id": "image_7",
      "label": "Image 7"
    },
    {
      "type": "image_picker",
      "id": "image_8",
      "label": "Image 8"

{% doc %}
  @prompt
    can you create a logo slider with some paddings top and bottom
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-slider-{{ ai_gen_id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-logo-slider-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-logo-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-logo-slider-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.logo_spacing }}px;
    animation: ai-logo-slide-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    width: fit-content;
  }

  .ai-logo-slider-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_height }}px;
    background-color: {{ block.settings.logo_background_color }};
    border-radius: {{ block.settings.logo_border_radius }}px;
    padding: {{ block.settings.logo_padding }}px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .ai-logo-slider-item-{{ ai_gen_id }}:hover {
    transform: scale({{ block.settings.hover_scale }});
    opacity: {{ block.settings.hover_opacity | divided_by: 100.0 }};
  }

  .ai-logo-slider-item-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale({{ block.settings.grayscale_amount }}%);
    transition: filter 0.3s ease;
  }

  .ai-logo-slider-item-{{ ai_gen_id }}:hover img {
    filter: grayscale({{ block.settings.hover_grayscale_amount }}%);
  }

  .ai-logo-slider-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.logo_border_radius }}px;
  }

  .ai-logo-slider-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  {% if block.settings.pause_on_hover %}
    .ai-logo-slider-wrapper-{{ ai_gen_id }}:hover .ai-logo-slider-track-{{ ai_gen_id }} {
      animation-play-state: paused;
    }
  {% endif %}

  @keyframes ai-logo-slide-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-{{ block.settings.logo_width }}px - {{ block.settings.logo_spacing }}px));
    }
  }

  @media screen and (max-width: 749px) {
    .ai-logo-slider-item-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.8 }}px;
      height: {{ block.settings.logo_height | times: 0.8 }}px;
    }

    .ai-logo-slider-container-{{ ai_gen_id }} {
      padding: 0 15px;
    }
  }
{% endstyle %}

<logo-slider-{{ ai_gen_id }}
  class="ai-logo-slider-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-logo-slider-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 style="text-align: {{ block.settings.heading_alignment }}; color: {{ block.settings.heading_color }}; margin-bottom: {{ block.settings.heading_margin }}px; font-size: {{ block.settings.heading_size }}px;">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    <div class="ai-logo-slider-wrapper-{{ ai_gen_id }}">
      <div class="ai-logo-slider-track-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% liquid
            assign logo_key = 'logo_' | append: i
            assign logo = block.settings[logo_key]
          %}
          
          <div class="ai-logo-slider-item-{{ ai_gen_id }}">
            {% if logo != blank %}
              <img
                src="{{ logo | image_url: width: 400 }}"
                alt="{{ logo.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.logo_width }}"
                height="{{ block.settings.logo_height }}"
              >
            {% else %}
              <div class="ai-logo-slider-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}

        {% for i in (1..8) %}
          {% liquid
            assign logo_key = 'logo_' | append: i
            assign logo = block.settings[logo_key]
          %}
          
          <div class="ai-logo-slider-item-{{ ai_gen_id }}">
            {% if logo != blank %}
              <img
                src="{{ logo | image_url: width: 400 }}"
                alt="{{ logo.alt | escape }}"
                loading="lazy"
                width="{{ block.settings.logo_width }}"
                height="{{ block.settings.logo_height }}"
              >
            {% else %}
              <div class="ai-logo-slider-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</logo-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class LogoSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-logo-slider-track-{{ ai_gen_id }}');
        this.setupSlider();
      }

      setupSlider() {
        if (!this.track) return;

        const items = this.track.querySelectorAll('.ai-logo-slider-item-{{ ai_gen_id }}');
        const itemWidth = {{ block.settings.logo_width }};
        const gap = {{ block.settings.logo_spacing }};
        const totalWidth = (itemWidth + gap) * items.length / 2;

        this.track.style.width = `${totalWidth * 2}px`;
      }
    }

    customElements.define('logo-slider-{{ ai_gen_id }}', LogoSlider{{ ai_gen_id }});
  })();
</script>


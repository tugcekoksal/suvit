{% liquid
  assign collection_title = ''
  assign collection = closest.collection

  if block.settings.title_metafield != blank
    if block.settings.title_metafield contains '.'
      if collection
        assign mf_parts = block.settings.title_metafield | split: '.'
        if mf_parts.size == 2
          assign collection_title = collection.metafields[mf_parts[0]][mf_parts[1]]
        endif
      endif
    else
      assign collection_title = block.settings.title_metafield
    endif
  endif

  if collection_title == blank and collection
    assign collection_title = collection.title
  endif

  if collection_title == blank
    assign collection_title = 'sections.collection_list.collection_title' | t 
  endif
%}

{% if collection_title != blank %}
  {% style %}
    .block-{{ block.id }} {
      --pad-top: {{ block.settings.desktop_padding_top }}px;
      --pad-bottom: {{ block.settings.desktop_padding_bottom }}px;
      --pad-left: {{ block.settings.desktop_padding_left }}px;
      --pad-right: {{ block.settings.desktop_padding_right }}px;
      --pad-top-m: {{ block.settings.mobile_padding_top }}px;
      --pad-bottom-m: {{ block.settings.mobile_padding_bottom }}px;
      --pad-left-m: {{ block.settings.mobile_padding_left }}px;
      --pad-right-m: {{ block.settings.mobile_padding_right }}px;
      {% if block.settings.heading_size == 'custom' %}
        font-size: {{ block.settings.mobile_font_size }}px;
        line-height: {{ block.settings.line_height }}%;
      {% endif %}
    }
    {% if block.settings.heading_size == 'custom' %}
      @media (min-width: 768px) {
        .block-{{ block.id }} {
          font-size: {{ block.settings.desktop_font_size }}px;
          line-height: {{ block.settings.line_height }}%;
        }
      }
    {% endif %}

    .maximize-theme:not(.dark) .block-collection-title.block-{{ block.id }} {
        {% if block.settings.title_color_light.alpha != 0.0 %}
          color: rgba({{ block.settings.title_color_light.red }} {{ block.settings.title_color_light.green }} {{ block.settings.title_color_light.blue }} / {{ block.settings.title_color_light.alpha }});
          --color-heading: {{ block.settings.title_color_light.red }} {{ block.settings.title_color_light.green }} {{ block.settings.title_color_light.blue }} / {{ block.settings.title_color_light.alpha }};
        {% endif %}
    }
    .maximize-theme.dark .block-collection-title.block-{{ block.id }} {
        {% if block.settings.title_color_dark.alpha != 0.0 %}
            color: rgba({{ block.settings.title_color_dark.red }} {{ block.settings.title_color_dark.green }} {{ block.settings.title_color_dark.blue }} / {{ block.settings.title_color_dark.alpha }});
            --color-heading: {{ block.settings.title_color_dark.red }} {{ block.settings.title_color_dark.green }} {{ block.settings.title_color_dark.blue }} / {{ block.settings.title_color_dark.alpha }};
        {% endif %}
    }
  {% endstyle %}

  {% if block.settings.enable_link and collection != blank %}
    <a href="{{ collection.url }}" aria-label="{{ 'sections.collection_list.view_collection' | t }}: {{ collection_title | escape }}">
  {% endif %}
    <{{ block.settings.heading_tag }}
      class="block-collection-title block-padding p-break-words transition duration-200 anm-fade-element text-animation-item block-{{ block.id }} maximize-block p-break-words heading-{{ block.settings.heading_size }} {% if block.settings.enable_link and collection != blank %} link-reveal{%- endif -%}"
      data-block-id="{{ block.id }}"
      {{ block.shopify_attributes }}
    >
      {{ collection_title }}
    </{{ block.settings.heading_tag }}>

  {% if block.settings.enable_link and collection != blank %}
    </a>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Collection title",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "label": "Link to collection",
      "id": "enable_link",
      "default": true
    },
    {
      "type": "text",
      "label": "Collection alternate title",
      "id": "title_metafield",
      "info": "Override collection title. E.g: custom.display_title. Leave empty to use default title."
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "default": "h2",
      "label": "t:global.text.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "p"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Font size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "medium"
    },
    {
      "type": "range",
      "id": "desktop_font_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Desktop font size",
      "default": 14,
      "visible_if": "{{ block.settings.heading_size == 'custom' }}"
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Mobile font size",
      "default": 14,
      "visible_if": "{{ block.settings.heading_size == 'custom' }}"
    },
    {
      "type": "range",
      "id": "line_height",
      "min": 100,
      "max": 300,
      "step": 5,
      "unit": "%",
      "label": "Line height",
      "default": 140,
      "visible_if": "{{ block.settings.heading_size == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "select",
      "id": "spacing_choose_device",
      "label": "Choose device",
      "options": [
        {
          "value": "desktop",
          "label": "Desktop"
        },
        {
          "value": "mobile",
          "label": "Mobile"
        }
      ],
      "default": "desktop",
      "info": "Desktop and Mobile settings are configured separately."
    },
    {
      "type": "range",
      "id": "desktop_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "desktop_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "desktop_padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Left",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "desktop_padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Right",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'desktop' }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Left",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'mobile' }}"
    },
    {
      "type": "range",
      "id": "mobile_padding_right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Right",
      "default": 0,
      "visible_if": "{{ block.settings.spacing_choose_device == 'mobile' }}"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "title_color_light",
      "default": "rgba(0,0,0,0)",
      "label": "Title color (light)"
    },
    {
      "type": "color",
      "id": "title_color_dark",
      "default": "rgba(0,0,0,0)",
      "label": "Title color (dark)"
    }
  ],
  "presets": [
    {
      "name": "Collection title"
    }
  ]
}
{% endschema %}

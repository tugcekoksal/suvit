{% doc %}
  @prompt
    video section which should be visible only if i add a video link inside product 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-video-{{ ai_gen_id }} {
    width: 100%;
    margin: {{ block.settings.section_margin_top }}px 0 {{ block.settings.section_margin_bottom }}px;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-product-video__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-product-video__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.text_alignment }};
    margin: 0 0 {{ block.settings.heading_margin_bottom }}px;
    line-height: 1.2;
  }

  .ai-product-video__description-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    text-align: {{ block.settings.text_alignment }};
    margin: 0 0 {{ block.settings.description_margin_bottom }}px;
    line-height: 1.5;
  }

  .ai-product-video__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.aspect_ratio }}%;
    border-radius: {{ block.settings.video_border_radius }}px;
    overflow: hidden;
    background-color: #000;
  }

  .ai-product-video__iframe-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-product-video__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f4f4f4;
    color: #666;
    font-size: 16px;
    text-align: center;
    padding: 20px;
  }

  .ai-product-video__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    background-color: #f9f9f9;
    border-radius: {{ block.settings.border_radius }}px;
    color: #666;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-product-video-{{ ai_gen_id }} {
      margin: {{ block.settings.section_margin_top | times: 0.7 }}px 0 {{ block.settings.section_margin_bottom | times: 0.7 }}px;
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px {{ block.settings.section_padding_horizontal | times: 0.7 }}px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }

    .ai-product-video__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-product-video__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

{% liquid
  assign video_url = block.settings.video_url
  assign video_id = ''
  assign video_platform = ''
  assign embed_url = ''

  if video_url contains 'youtube.com' or video_url contains 'youtu.be'
    assign video_platform = 'youtube'
    if video_url contains 'youtu.be/'
      assign video_id = video_url | split: 'youtu.be/' | last | split: '?' | first
    elsif video_url contains 'watch?v='
      assign video_id = video_url | split: 'watch?v=' | last | split: '&' | first
    elsif video_url contains 'embed/'
      assign video_id = video_url | split: 'embed/' | last | split: '?' | first
    endif
    assign embed_url = 'https://www.youtube.com/embed/' | append: video_id | append: '?rel=0&modestbranding=1'
  elsif video_url contains 'vimeo.com'
    assign video_platform = 'vimeo'
    assign video_id = video_url | split: 'vimeo.com/' | last | split: '?' | first
    assign embed_url = 'https://player.vimeo.com/video/' | append: video_id | append: '?title=0&byline=0&portrait=0'
  endif
%}

{% if video_url != blank and video_id != blank %}
  <div class="ai-product-video-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-product-video__container-{{ ai_gen_id }}">
      {% if block.settings.heading != blank %}
        <h2 class="ai-product-video__heading-{{ ai_gen_id }}">
          {{ block.settings.heading }}
        </h2>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-product-video__description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      <div class="ai-product-video__wrapper-{{ ai_gen_id }}">
        {% if embed_url != blank %}
          <iframe
            class="ai-product-video__iframe-{{ ai_gen_id }}"
            src="{{ embed_url }}"
            title="{{ block.settings.heading | default: 'Product video' | escape }}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        {% else %}
          <div class="ai-product-video__placeholder-{{ ai_gen_id }}">
            <p>Video format not supported. Please use a YouTube or Vimeo URL.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
{% elsif request.design_mode %}
  <div class="ai-product-video-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-product-video__container-{{ ai_gen_id }}">
      <div class="ai-product-video__empty-state-{{ ai_gen_id }}">
        <p><strong>Product Video Section</strong></p>
        <p>This section will only appear when you add a video URL. Add a YouTube or Vimeo link to get started.</p>
      </div>
    </div>
  </div>
{% endif %}


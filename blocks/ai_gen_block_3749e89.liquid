{% doc %}
  @prompt
    logo slider
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-logo-slider-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-logo-slider-container-{{ ai_gen_id }} {
    max-width: {{ settings.page_width }}px;
    margin: 0 auto;
    padding: 0 {{ settings.spacing_grid_horizontal }}px;
  }

  .ai-logo-slider-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_margin }}px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ settings.type_header_font.weight }};
    margin-top: 0;
  }

  .ai-logo-slider-track-{{ ai_gen_id }} {
    display: flex;
    animation: ai-logo-slide-{{ ai_gen_id }} {{ block.settings.animation_speed }}s linear infinite;
    gap: {{ block.settings.logo_spacing }}px;
  }

  .ai-logo-slider-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.logo_width }}px;
    height: {{ block.settings.logo_height }}px;
    background-color: {{ block.settings.logo_background_color }};
    border-radius: {{ settings.media_radius }}px;
    padding: {{ block.settings.logo_padding }}px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .ai-logo-slider-item-{{ ai_gen_id }}:hover {
    transform: scale({{ block.settings.hover_scale }});
    opacity: {{ block.settings.hover_opacity | divided_by: 100.0 }};
  }

  .ai-logo-slider-item-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: grayscale({{ block.settings.grayscale_amount }}%);
    transition: filter 0.3s ease;
  }

  .ai-logo-slider-item-{{ ai_gen_id }}:hover img {
    filter: grayscale({{ block.settings.hover_grayscale_amount }}%);
  }

  .ai-logo-slider-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ settings.media_radius }}px;
  }

  .ai-logo-slider-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-logo-slider-empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: {{ settings.body_font_size }}px;
  }

  @keyframes ai-logo-slide-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(calc(-{{ block.settings.logo_width }}px - {{ block.settings.logo_spacing }}px));
    }
  }

  .ai-logo-slider-{{ ai_gen_id }}:hover .ai-logo-slider-track-{{ ai_gen_id }} {
    animation-play-state: {{ block.settings.pause_on_hover | default: true | ternary: 'paused', 'running' }};
  }

  @media screen and (max-width: 749px) {
    .ai-logo-slider-item-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.8 }}px;
      height: {{ block.settings.logo_height | times: 0.8 }}px;
    }

    .ai-logo-slider-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    @keyframes ai-logo-slide-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(calc(-{{ block.settings.logo_width | times: 0.8 }}px - {{ block.settings.logo_spacing }}px));
      }
    }
  }
{% endstyle %}

<logo-slider-{{ ai_gen_id }} class="ai-logo-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-logo-slider-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-logo-slider-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% assign has_logos = false %}
    {% for i in (1..8) %}
      {% assign logo_key = 'logo_' | append: i %}
      {% if block.settings[logo_key] != blank %}
        {% assign has_logos = true %}
        {% break %}
      {% endif %}
    {% endfor %}

    {% if has_logos %}
      <div class="ai-logo-slider-track-{{ ai_gen_id }}">
        {% for repeat in (1..3) %}
          {% for i in (1..8) %}
            {% assign logo_key = 'logo_' | append: i %}
            {% assign logo_url_key = 'logo_url_' | append: i %}
            {% assign logo = block.settings[logo_key] %}
            {% assign logo_url = block.settings[logo_url_key] %}
            
            {% if logo != blank %}
              <div class="ai-logo-slider-item-{{ ai_gen_id }}">
                {% if logo_url != blank %}
                  <a href="{{ logo_url }}" target="_blank" rel="noopener noreferrer">
                    <img
                      src="{{ logo | image_url: width: 400 }}"
                      alt="{{ logo.alt | escape }}"
                      loading="lazy"
                      width="{{ logo.width }}"
                      height="{{ logo.height }}"
                    >
                  </a>
                {% else %}
                  <img
                    src="{{ logo | image_url: width: 400 }}"
                    alt="{{ logo.alt | escape }}"
                    loading="lazy"
                    width="{{ logo.width }}"
                    height="{{ logo.height }}"
                  >
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    {% else %}
      <div class="ai-logo-slider-empty-state-{{ ai_gen_id }}">
        <div class="ai-logo-slider-item-{{ ai_gen_id }}">
          <div class="ai-logo-slider-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        </div>
        <p>Add logos to display in the slider</p>
      </div>
    {% endif %}
  </div>
</logo-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class LogoSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.track = this.querySelector('.ai-logo-slider-track-{{ ai_gen_id }}');
        this.setupSlider();
      }

      setupSlider() {
        if (!this.track) return;

        const items = this.track.querySelectorAll('.ai-logo-slider-item-{{ ai_gen_id }}');
        if (items.length === 0) return;

        this.track.addEventListener('animationiteration', () => {
          this.track.style.transform = 'translateX(0)';
        });

        {% if block.settings.pause_on_hover %}
          this.addEventListener('mouseenter', () => {
            this.track.style.animationPlayState = 'paused';
          });

          this.addEventListener('mouseleave', () => {
            this.track.style.animationPlayState = 'running';
          });
        {% endif %}
      }
    }

    customElements.define('logo-slider-{{ ai_gen_id }}', LogoSlider{{ ai_gen_id }});
  })();
</script>


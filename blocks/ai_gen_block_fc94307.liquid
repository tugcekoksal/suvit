{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-tabs-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    padding: 40px 0;
  }

  .ai-product-tabs-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-product-tabs-nav-{{ ai_gen_id }} {
    display: flex;
    gap: 0;
    border-bottom: 2px solid {{ block.settings.border_color }};
    margin-bottom: 30px;
  }

  .ai-product-tabs-button-{{ ai_gen_id }} {
    flex: 1;
    padding: 16px 24px;
    background: none;
    border: none;
    cursor: pointer;
    font-size: {{ block.settings.tab_font_size }}px;
    font-weight: 600;
    color: {{ block.settings.inactive_tab_color }};
    transition: all 0.3s ease;
    position: relative;
    border-bottom: 3px solid transparent;
  }

  .ai-product-tabs-button-{{ ai_gen_id }}:hover {
    color: {{ block.settings.active_tab_color }};
  }

  .ai-product-tabs-button-{{ ai_gen_id }}.active {
    color: {{ block.settings.active_tab_color }};
    border-bottom-color: {{ block.settings.active_tab_color }};
  }

  .ai-product-tabs-content-{{ ai_gen_id }} {
    display: none;
    animation: ai-product-tabs-fade-in-{{ ai_gen_id }} 0.3s ease;
  }

  .ai-product-tabs-content-{{ ai_gen_id }}.active {
    display: block;
  }

  @keyframes ai-product-tabs-fade-in-{{ ai_gen_id }} {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .ai-product-tabs-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.content_font_size }}px;
    line-height: 1.6;
  }

  .ai-product-tabs-description-{{ ai_gen_id }} p {
    margin-bottom: 16px;
  }

  .ai-product-tabs-technical-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
  }

  .tech-data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: {{ block.settings.content_font_size }}px;
  }

  .tech-data-table th {
    text-align: left;
    font-weight: 600;
    padding: 12px 16px;
    border-bottom: 1px solid {{ block.settings.border_color }};
    width: 200px;
    vertical-align: top;
  }

  .tech-data-table td {
    padding: 12px 16px;
    border-bottom: 1px solid {{ block.settings.border_color }};
    vertical-align: top;
  }

  .tech-data-table tr:last-child th,
  .tech-data-table tr:last-child td {
    border-bottom: none;
  }

  .ai-product-tabs-empty-{{ ai_gen_id }} {
    color: #999999;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-product-tabs-button-{{ ai_gen_id }} {
      padding: 12px 16px;
      font-size: {{ block.settings.tab_font_size | times: 0.9 }}px;
    }

    .tech-data-table th,
    .tech-data-table td {
      display: block;
      width: 100%;
      padding: 8px 12px;
    }

    .tech-data-table th {
      padding-bottom: 4px;
      border-bottom: none;
    }

    .tech-data-table td {
      padding-top: 0;
    }
  }
{% endstyle %}

<product-tabs-{{ ai_gen_id }} class="ai-product-tabs-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-tabs-container-{{ ai_gen_id }}">
    <div class="ai-product-tabs-nav-{{ ai_gen_id }}" role="tablist">
      <button
        class="ai-product-tabs-button-{{ ai_gen_id }} active"
        role="tab"
        aria-selected="true"
        aria-controls="ai-product-tabs-panel-description-{{ ai_gen_id }}"
        data-tab="description"
      >
        {{ block.settings.description_tab_label }}
      </button>
      <button
        class="ai-product-tabs-button-{{ ai_gen_id }}"
        role="tab"
        aria-selected="false"
        aria-controls="ai-product-tabs-panel-technical-{{ ai_gen_id }}"
        data-tab="technical"
      >
        {{ block.settings.technical_tab_label }}
      </button>
    </div>

    <div
      id="ai-product-tabs-panel-description-{{ ai_gen_id }}"
      class="ai-product-tabs-content-{{ ai_gen_id }} active"
      role="tabpanel"
    >
      <div class="ai-product-tabs-description-{{ ai_gen_id }}">
        {% if product.description != blank %}
          {{ product.description }}
        {% else %}
          <p class="ai-product-tabs-empty-{{ ai_gen_id }}">{{ block.settings.empty_description_text }}</p>
        {% endif %}
      </div>
    </div>

    <div
      id="ai-product-tabs-panel-technical-{{ ai_gen_id }}"
      class="ai-product-tabs-content-{{ ai_gen_id }}"
      role="tabpanel"
    >
      <div class="ai-product-tabs-technical-{{ ai_gen_id }}">
        {% if product.metafields.custom.technische_daten.value %}
          <table class="tech-data-table">
            <tbody>
              {% for entry in product.metafields.custom.technische_daten.value %}
                {% if entry.product %}
                  <tr>
                    <th>Product</th>
                    <td>{{ entry.product }}</td>
                  </tr>
                {% endif %}

                {% if entry.material %}
                  <tr>
                    <th>Material</th>
                    <td>{{ entry.material }}</td>
                  </tr>
                {% endif %}

                {% if entry.farben %}
                  <tr>
                    <th>Farben</th>
                    <td>{{ entry.farben }}</td>
                  </tr>
                {% endif %}

                {% if entry.breite %}
                  <tr>
                    <th>Breite</th>
                    <td>{{ entry.breite | metafield_text }}</td>
                  </tr>
                {% endif %}

                {% if entry.breiten %}
                  <tr>
                    <th>Breiten</th>
                    <td>{{ entry.breiten }}</td>
                  </tr>
                {% endif %}

                {% if entry.produktabmessungen %}
                  <tr>
                    <th>Produktabmessungen</th>
                    <td>{{ entry.produktabmessungen }}</td>
                  </tr>
                {% endif %}

                {% if entry.hohe %}
                  <tr>
                    <th>Höhe</th>
                    <td>{{ entry.hohe | metafield_text }}</td>
                  </tr>
                {% endif %}

                {% if entry.tiefe %}
                  <tr>
                    <th>Tiefe</th>
                    <td>{{ entry.tiefe | metafield_text }}</td>
                  </tr>
                {% endif %}

                {% if entry.art %}
                  <tr>
                    <th>Art</th>
                    <td>{{ entry.art }}</td>
                  </tr>
                {% endif %}

                {% if entry.gewicht %}
                  <tr>
                    <th>Gewicht</th>
                    <td>{{ entry.gewicht | metafield_text }}</td>
                  </tr>
                {% endif %}

                {% if entry.montageart %}
                  <tr>
                    <th>Montageart</th>
                    <td>{{ entry.montageart }}</td>
                  </tr>
                {% endif %}
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="ai-product-tabs-empty-{{ ai_gen_id }}">{{ block.settings.empty_technical_text }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</product-tabs-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductTabs{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.buttons = this.querySelectorAll('.ai-product-tabs-button-{{ ai_gen_id }}');
        this.contents = this.querySelectorAll('.ai-product-tabs-content-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.buttons.forEach((button) => {
          button.addEventListener('click', () => {
            const tabName = button.getAttribute('data-tab');
            this.switchTab(tabName);
          });
        });
      }

      switchTab(tabName) {
        this.buttons.forEach((btn) => {
          const isActive = btn.getAttribute('data-tab') === tabName;
          btn.classList.toggle('active', isActive);
          btn.setAttribute('aria-selected', isActive);
        });

        this.contents.forEach((content) => {
          const contentId = content.getAttribute('id');
          const isActive = contentId.includes(tabName);
          content.classList.toggle('active', isActive);
        });
      }
    }

    customElements.define('product-tabs-{{ ai_gen_id }}', ProductTabs{{ ai_gen_id }});
  })();
</script>


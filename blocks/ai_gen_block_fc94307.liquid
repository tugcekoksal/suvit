    {
      "type": "text",
      "id": "technical_tab_label",
      "label": "Technical data tab label",
      "default": "Technische Daten"
    },
    {
      "type": "header",
      "content": "Empty state messages"
    },
    {
      "type": "text",
      "id": "empty_description_text",
      "label": "Empty description message",
      "default": "Keine Produktbeschreibung verfügbar"
    },
    {
      "type": "text",
      "id": "empty_technical_text",
      "label": "Empty technical data message",
      "default": "Keine technischen Daten verfügbar"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "active_tab_color",
      "label": "Active tab color",
      "default": "#353535"
    },
    {
      "type": "color",
      "id": "inactive_tab_color",
      "label": "Inactive tab color",
      "default": "#999999"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e0e0e0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#353535"
    },
    {
      "type": "range",
      "id": "tab_font_size",
      "min": 12,
      "max": 24,

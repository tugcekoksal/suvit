{% doc %}
  @prompt
    can you create a quote section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-quote-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_horizontal }}px {{ block.settings.padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-quote-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-quote-icon-{{ ai_gen_id }} {
    display: inline-block;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    color: {{ block.settings.icon_color }};
    opacity: {{ block.settings.icon_opacity | divided_by: 100.0 }};
  }

  .ai-quote-icon-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
  }

  .ai-quote-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_font_size }}px;
    line-height: {{ block.settings.quote_line_height }};
    color: {{ block.settings.quote_color }};
    margin: 0 0 {{ block.settings.quote_spacing }}px;
    font-style: {{ block.settings.quote_style }};
    font-weight: {{ block.settings.quote_weight }};
  }

  .ai-quote-author-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_font_size }}px;
    color: {{ block.settings.author_color }};
    margin: 0;
    font-weight: {{ block.settings.author_weight }};
  }

  .ai-quote-divider-{{ ai_gen_id }} {
    width: {{ block.settings.divider_width }}px;
    height: {{ block.settings.divider_height }}px;
    background-color: {{ block.settings.divider_color }};
    margin: {{ block.settings.divider_spacing }}px auto;
    border-radius: {{ block.settings.divider_radius }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-quote-section-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top | times: 0.7 }}px {{ block.settings.padding_horizontal | times: 0.7 }}px {{ block.settings.padding_bottom | times: 0.7 }}px;
    }

    .ai-quote-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.quote_font_size | times: 0.8 }}px;
    }

    .ai-quote-icon-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<quote-section-{{ ai_gen_id }}
  class="ai-quote-section-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-quote-container-{{ ai_gen_id }}">
    {% if block.settings.show_icon %}
      <div class="ai-quote-icon-{{ ai_gen_id }}">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
          <path d="M6 17h3l2-4V7H5v6h3zm8 0h3l2-4V7h-6v6h3z"/>
        </svg>
      </div>
    {% endif %}

    {% if block.settings.quote_text != blank %}
      <blockquote class="ai-quote-text-{{ ai_gen_id }}">
        {{ block.settings.quote_text }}
      </blockquote>
    {% endif %}

    {% if block.settings.show_divider %}
      <div class="ai-quote-divider-{{ ai_gen_id }}"></div>
    {% endif %}

    {% if block.settings.author_name != blank %}
      <p class="ai-quote-author-{{ ai_gen_id }}">
        {{ block.settings.author_name }}
      </p>
    {% endif %}
  </div>
</quote-section-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Quote section",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "richtext",
      "id": "quote_text",

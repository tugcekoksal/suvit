{% liquid
  assign settings = block.settings

  case settings.mobile_horizontal_alignment
    when 'left'
      assign mobile_h_flex = 'start'
    when 'right'
      assign mobile_h_flex = 'end'
    else
      assign mobile_h_flex = 'center'
  endcase

  case settings.desktop_horizontal_alignment
    when 'left'
      assign desktop_h_flex = 'start'
    when 'right'
      assign desktop_h_flex = 'end'
    else
      assign desktop_h_flex = 'center'
  endcase
%}

{% liquid
  assign number_of_gap = block.blocks.size | minus: 1 
  if number_of_gap < 0
    assign number_of_gap = 0
  endif
%}

{% style %}
  .block-{{ block.id }} {
    {% if settings.width == 'fit' %}
      width: fit-content;
      --block-width: fit-content;
    {% elsif settings.width == 'custom' %}
      width: {{ settings.mobile_group_width }}%;
      --block-width: {{ settings.mobile_group_width | divided_by: 100.0 }};
    {% endif %}
    {% if settings.height == 'custom' %}
      height: {{ settings.mobile_group_height }}%;
    {% else %}
      height: fit-content;
    {% endif %}
    --pad-top: {{ block.settings.desktop_padding_top }}px;
    --pad-bottom: {{ block.settings.desktop_padding_bottom }}px;
    --pad-left: {{ block.settings.desktop_padding_left }}px;
    --pad-right: {{ block.settings.desktop_padding_right }}px;
    --pad-top-m: {{ block.settings.mobile_padding_top }}px;
    --pad-bottom-m: {{ block.settings.mobile_padding_bottom }}px;
    --pad-left-m: {{ block.settings.mobile_padding_left }}px;
    --pad-right-m: {{ block.settings.mobile_padding_right }}px;
  }
  @media (max-width: 767px) {
    .group-content-{{ block.id }} {
      flex-direction: {% if settings.mobile_direction == 'col' %}column{% else %}row{% endif %};
      {% if settings.mobile_direction == 'col' %}
        justify-content: {{ settings.mobile_vertical_alignment }};
        align-items: {{ mobile_h_flex }};
      {% else %}
        justify-content: {{ mobile_h_flex }};
        align-items: {{ settings.mobile_vertical_alignment }};
      {% endif %}
      text-align: {{ settings.mobile_horizontal_alignment }};
      gap: calc({{ settings.gap }}px * var(--mobile-padding-ratio));
    }
    {% if settings.mobile_direction == 'row' %}
      .block-group.block-{{ block.id }} {
        display: grid;
      }
    {% endif %}
  }

  @media (min-width: 768px) {
    .block-{{ block.id }} {
      {% if settings.width == 'custom' %}
        width: {{ settings.desktop_group_width }}%;
        --block-width: {{ settings.desktop_group_width | divided_by: 100.0 }};
      {% endif %}
      {% if settings.height == 'custom' %}
        height: {{ settings.desktop_group_height }}%;
      {% else %}
        height: fit-content;
      {% endif %}
    }
    .group-content-{{ block.id }} {
      flex-direction: {% if settings.desktop_direction == 'col' %}column{% else %}row{% endif %};
      {% if settings.desktop_direction == 'col' %}
        justify-content: {{ settings.desktop_vertical_alignment }};
        align-items: {{ desktop_h_flex }};
      {% else %}
        justify-content: {{ desktop_h_flex }};
        align-items: {{ settings.desktop_vertical_alignment }};
      {% endif %}
      text-align: {{ settings.desktop_horizontal_alignment }};
      gap: {{ settings.gap }}px;
    }
    {% if settings.desktop_direction == 'row' %}
      .block-group.block-{{ block.id }} {
        display: grid;
      }
    {% endif %}
  }
{% endstyle %}

<div
  class="block-group block-{{ block.id }} maximize-block rounded-corners relative"
  data-block-id="{{ block.id }}"
  {{ block.shopify_attributes }}
>
  <div
    class="block-group__content group-content-{{ block.id }} relative w-full h-full flex rounded-corners block-padding ltr color-{{ settings.color_scheme_light }} dark-color-{{ settings.color_scheme_dark -}}
    {%- if settings.show_border_mobile or settings.show_border %} color-border-[rgba(var(--color-line-and-border))] border-solid{% if settings.show_border %} md:border{% endif %}{% if settings.show_border_mobile %} sm:border{% endif %}{% endif -%}"
  >
    {% if block.settings.group_link != blank %}
      <a
        href="{{ settings.group_link }}"
        aria-label="{{ settings.group_link | escape }}"
        class="block__group--link absolute inset-0 min-w-6 min-h-6"
        {% if settings.open_new_window %}target="_blank" rel="noopener noreferrer"{% endif %}
      >
        <span class="sr-only">{{ settings.group_link | escape }}</span>
    {% endif %}
      {%- if settings.background_media == 'image' -%}
        <div class="block-group__bg absolute inset-0 overflow-hidden rounded-corners">
          {%- if settings.background_image_desktop != blank or settings.background_image_mobile != blank -%}
            {%- liquid
              if section.index == 1 and section.location == 'template'
                assign bg_loading = 'eager'
              else
                assign bg_loading = 'lazy'
              endif

              assign _page_w = settings.page_width | default: 1400
              assign _section_width = section.settings.section_width | default: 'page-width'

              if settings.width == 'custom'
                assign _desktop_group_pct = settings.desktop_group_width
                assign _mobile_group_pct = settings.mobile_group_width
              else
                assign _desktop_group_pct = 100
                assign _mobile_group_pct = 100
              endif

              if _section_width == 'full-width' or _section_width == 'full-width-padded'
                assign bg_sizes = '(min-width: 768px) ' | append: _desktop_group_pct | append: 'vw, ' | append: _mobile_group_pct | append: 'vw'
              else
                assign _desktop_max_px = _page_w | times: _desktop_group_pct | divided_by: 100 | round
                assign bg_sizes = '(min-width: ' | append: _page_w | append: 'px) ' | append: _desktop_max_px | append: 'px, (min-width: 768px) ' | append: _desktop_group_pct | append: 'vw, ' | append: _mobile_group_pct | append: 'vw'
              endif
            -%}
            {%- render 'image-new',
              image: settings.background_image_desktop,
              image_mobile: settings.background_image_mobile,
              image_class: 'w-full h-full object-cover image-hover anm-image-hover',
              image_mobile_class: 'w-full h-full object-cover',
              loading: bg_loading,
              sizes: bg_sizes
            -%}
          {%- else -%}
            <div class="absolute w-full h-full overflow-hidden flex justify-center items-center rounded-corners scale-150">
              {%- render 'placeholder-image', image_type: 'image' -%}
            </div>
          {%- endif -%}
          <div class="absolute inset-0 scheme-image-overlay opacity-{{ settings.overlay_opacity }}"></div>
        </div>
      {%- endif -%}
    {% if block.settings.group_link != blank %}
      </a>
    {% endif %}
    {% content_for 'blocks' %}
  </div>
</div>


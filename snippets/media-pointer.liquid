<media-pointer class="fixed inset-0 w-full h-full pointer-events-none z-[99999] lg:block hidden !bg-transparent">
  <div
    class="media-pointer-circle cursor-none fixed top-0 left-0 w-[70px] h-[70px] rounded-full flex items-center justify-center opacity-0 invisible will-change-transform pointer-events-none backdrop-blur-sm"
  >
    <span class="media-pointer-text cursor-none text-small pointer-events-none">
      {{ 'accessibility.click' | t }}
    </span>
    
    <div class="media-pointer-icon absolute top-4.5 right-3 w-3 h-3 flex-shrink-0 -rotate-30" aria-hidden="true">
      {% render 'icon-all', icon: 'arr-pointer' %}
    </div>
  </div>
</media-pointer>
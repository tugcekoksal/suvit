{% comment %}
  Renders a product card

  Accepts:
  - card_product: {Object} Product Liquid object (optional)
  - card_variant: {Object} Variant Liquid object (optional)  ✅ NEW
  - media_aspect_ratio: {String} Size of the product image card. Values are "square" and "portrait". Default is "square" (optional)
  - image_shape: {String} Image mask to apply to the product image card. Values are "arch", "blob", "chevronleft", "chevronright", "diamond", "parallelogram", and "round". (optional)
  - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false (optional)
  - show_vendor: {Boolean} Show the product vendor. Default: false (optional)
  - show_product_price: {Boolean} Show the product price. Default: true (optional)
  - product_color_swatch: {Boolean} Default: true (optional)
  - show_rating: {Boolean} Show the product rating. Default: false
  - extend_height: {Boolean} Card height extends to available container space. Default: true (optional)
  - lazy_load: {Boolean} Image should be lazy loaded. Default: true (optional)
  - show_quick_add: {Boolean} Show the quick add button.
  - show_variant: {Boolean} Show variant. Default: true (optional)
  - show_badge: {Boolean} Show variant. Default: true (optional)
  - section_id: {String} The ID of the section that contains this card.
  - horizontal_class: {Boolean} Add a card--horizontal class if set to true. Default: false (optional)
  - horizontal_quick_add: {Boolean} Changes the quick add button styles when set to true. Default: false (optional)
  - placeholder_image: {String} The placeholder image to use when no product exists. Default: 'product-apparel-2' (optional)

  Usage:
  {% render 'card-product', show_vendor: section.settings.show_vendor %}
{% endcomment %}

{%- if card_product and card_product != empty -%}
  {%- liquid
    assign ratio = 1
    if card_product.featured_media and media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    elsif card_product.featured_media and media_aspect_ratio == 'adapt'
      assign ratio = card_product.featured_media.aspect_ratio
    endif
    if ratio == 0 or ratio == null
      assign ratio = 1
    endif

    if show_product_price == false
      assign show_price = show_product_price
    else
      assign show_price = true
    endif

    # ✅ NEW: choose which variant to display
    assign display_variant = card_variant | default: card_product.selected_or_first_available_variant

    # ✅ NEW: build URL that opens the correct variant
    assign card_url = card_product.url | default: routes.root_url
    if display_variant
      assign card_url = card_url | append: '?variant=' | append: display_variant.id
    endif

    # ✅ NEW: title shows variant
   assign display_title = card_product.title

# Sadece varyant ayrı kart olarak gösteriliyorsa varyant adını ekle
if card_variant != blank and show_variant == true and display_variant.title != 'Default Title'
  assign display_title = display_title | append: ' – ' | append: display_variant.title
endif


    # ✅ NEW: use variant image if available
    assign display_media = card_product.featured_media
    if card_variant != blank and display_variant and display_variant.image
  assign display_media = display_variant.image
endif
  -%}

  <div class="product_card card-wrapper product-card-wrapper underline-links-hover">
    <div class="card card--{{ settings.card_style }} {% if card_product.featured_media %} card--media{% else %} card--text{% endif %}
      {% if settings.card_style == 'standard' %} color-{{ settings.card_color_scheme }} gradient{% endif %}
      {% if image_shape and image_shape != 'default' %} card--shape{% endif %}
      {% if extend_height %} card--extend-height{% endif %}
      {% if horizontal_class %} card--horizontal{% endif %}" style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;">
      <div class="card__inner ratio" style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;">
        <div class="card__media {% if card_product.media[1] != null and show_secondary_image %}hover_fisrt-hide{% endif %} {% if image_shape and image_shape != 'default' %} shape--{{ image_shape }}{% endif %}">
          <div class="media media--hover-effect media--transparent image-hover-change animate--hover-effect-{{ settings.animations_hover_elements }}">
            <a href="{{ card_url }}" class="focus-inset" title="{{ display_title | escape }}" aria-label="{{ display_title | escape }}" tabindex="0"></a>

              {%- liquid
                if show_Video
                  assign videoIs = ''
                  for media in card_product.media
                  if media.media_type == 'video'
                    assign videoIs = 'available'
                    assign video_media = media | media_tag: image_size: "1920x", autoplay: true, loop: true, controls: false, preload: "none"
                    break
                  endif
                  endfor
                endif
             -%}
              {%- if show_Video and videoIs == 'available' -%}
                {{ video_media }}
              {%- else -%}

              {%- if display_media -%}
                {%- liquid
                  assign height = display_media.width | divided_by: display_media.aspect_ratio | round
                  assign sizes = '100vw'
                  assign widths = '165, 300, 375, 550, 750, 1100'
                  assign alt = display_media.alt | default: card_product.title | escape
                -%}
                {{ display_media | image_url: width: 550 | image_tag: loading: 'lazy', sizes: sizes, widths: widths, alt: alt, title: alt, class: 'card-product-image fisrt-Image hover-class focus-inset' }}
              {%- else -%}
                {%- if placeholder_image -%}
                  {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
                {%- else -%}
                  {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              {%- endif -%}

            {%- endif -%}

              {%- if card_product.media[1] != null and show_secondary_image -%}
                {%- liquid
                assign height = card_product.media[1].width | divided_by: card_product.media[1].aspect_ratio | round
                assign sizes = '100vw'
                assign widths = '165, 300, 375, 550, 750, 1100'
                assign alt = card_product.media[1].alt | escape -%}
                {{ card_product.media[1] | image_url: width: 550 | image_tag: loading: 'lazy', sizes: sizes, widths: widths, alt: alt, title: alt, class: 'second-Image' }}
              {%- endif -%}
            </div>
          </div>
        {%- if show_badge == true -%}
          <div class="card__content">
            <div class="card__badge {{ settings.badge_position }}">
              {%- if card_product.available == false -%}
                <span id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}" class="badge badge--bottom-left gradient color-{{ settings.sold_out_badge_color_scheme }}">
                  {{- 'products.product.sold_out' | t -}}
                </span>
              {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
                <span id="NoMediaStandardBadge-{{ section_id }}-{{ card_product.id }}" class="badge badge--bottom-left color-{{ settings.sale_badge_color_scheme }}">
                  {{- 'products.product.on_sale' | t -}}
                </span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>

      <div class="card__content {% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}">
        <div class="card__information">
          <a href="{{ card_url }}" title="{{ display_title | escape }}" class="card__heading product-title{% if card_product.featured_media or settings.card_style == 'standard' %} h3{% endif %} full-unstyled-link" aria-labelledby="CardLink-{{ section_id }}-{{ card_product.id }} Badge-{{ section_id }}-{{ card_product.id }}">
            {{ display_title | escape }}
          </a>
          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ card_product.vendor }}</div>
            {%- endif -%}

            {%- if show_rating and card_product.metafields.reviews.rating.value != blank -%}
              {% liquid
                assign rating_decimal = 0
                assign decimal = card_product.metafields.reviews.rating.value.rating | modulo: 1
                if decimal >= 0.3 and decimal <= 0.7
                  assign rating_decimal = 0.5
                elsif decimal > 0.7
                  assign rating_decimal = 1
                endif
              %}
              <div class="rating" role="img" aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: card_product.metafields.reviews.rating.value, rating_max: card_product.metafields.reviews.rating.value.scale_max }}">
                <span aria-hidden="true" class="rating-star" style="--rating: {{ card_product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ card_product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"></span>
              </div>
              <p class="rating-text caption">
                <span aria-hidden="true">{{- card_product.metafields.reviews.rating.value }} / {{ card_product.metafields.reviews.rating.value.scale_max -}}</span>
              </p>
              <p class="rating-count caption">
                <span aria-hidden="true">({{ card_product.metafields.reviews.rating_count }})</span>
                <span class="visually-hidden">{{- card_product.metafields.reviews.rating_count }} {{ 'accessibility.total_reviews' | t -}}</span>
              </p>
            {%- endif -%}

            {%- if show_price == true -%}
              {%- comment -%}
                Pass variant info too (harmless if your price snippet ignores it)
              {%- endcomment -%}
              {% render 'price', product: card_product, variant: display_variant, use_variant: true, price_class: '', show_compare_at_price: true %}
            {%- endif -%}

            {%- if card_product.quantity_price_breaks_configured? -%}
              <div class="card__information-volume-pricing-note">
                <span class="caption">{{ 'products.product.volume_pricing.note' | t }}</span>
              </div>
            {%- endif -%}

            {%- if show_variant == true and product_color_swatch == true -%}
              <div class="card_variant">
                {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
                {%- assign swatchColors = settings.swatchColors | newline_to_br | split: '<br />' -%}
                {%- for product_option in card_product.options_with_values -%}
                  {%- if product_option.name == 'color' or product_option.name == 'Color' or product_option.name == 'Colour' or product_option.name == 'colour' -%}
                    {%- for value in product_option.values -%}
                      {%-  liquid 
                        assign selected_variant = display_variant
                        for variant in card_product.variants
                          if variant.title contains value and variant.image
                            assign selected_variant = variant
                          endif
                        endfor
                        -%}
                      {%- comment -%} keep your swatch output as-is {%- endcomment -%}

                      {% if value.swatch %}
                        {%- liquid
                          assign swatch_value = null
                          assign swatch_image_class = null
                        -%}
                        {% if value.swatch.image and settings.variant_images == true  %}
                          {%-  liquid
                            assign image_url = value.swatch.image | image_url: width: 50
                            assign swatch_value = 'url(' | append: image_url | append: ')'
                            assign swatch_focal_point = value.swatch.image.presentation.focal_point
                            assign swatch_image_class = 'variant_image'
                          -%}
                        {% else %}
                          {% assign swatch_value = false %}
                        {% endif %}
                        <color-swatch
                          tabindex="0" {% if selected_variant.image.src %} data-variant-id="{{ selected_variant.id }}" data-variant-image="{{ selected_variant.image.src | image_url: width: 550 }}"{% else %}data-variant-id="{{ card_product.id }}" data-variant-image="{{ card_product.featured_media.image | image_url: width: 550 }}"{% endif %}
                          {% if swatch_value %}
                            class="{% if shape == 'square' %} swatch--square{% endif %} {% if value.swatch.image and settings.variant_images == true %}variant__image {% else %}variant__color{% endif %} {% if forloop.first %}active{% endif %} focus-offset"
                            style="background: {{ swatch_value }};{% if swatch_focal_point %} --swatch-focal-point: {{ swatch_focal_point }};{% endif %}"
                          {% else %}
                            {%- assign colorMatched = false -%}
                            {%- for colorData in swatchColors -%} 
                              {%- assign colorDatastep = colorData | split:":" -%}
                              {%- assign ruleName = colorDatastep[0] | strip -%}
                              {%- if value == ruleName -%}
                                {%- assign colorCodes = colorDatastep[1] | strip | split :"#" -%}
                                {%- assign colorNumber = 0 | plus: colorCodes.size -%}
                                {%- case colorNumber -%} 
                                  {%- when 2 -%}
                                    style="background: #{{ colorCodes[1] }}; --border-color: #{{ colorCodes[1] }};"
                                  {%- when 3 -%}
                                    style="background: linear-gradient(135deg, #{{colorCodes[1]}} 50%, #{{colorCodes[2]}} 50%); --border-color: #{{ colorCodes[1] }};"
                                  {%- when 4 -%}
                                    style="background: linear-gradient(to right,#{{ colorCodes[1] }} 33%, #{{ colorCodes[2] }} 33%, #{{ colorCodes[2] }} 66%, #{{ colorCodes[3] }} 66%);"
                                {%- endcase -%}
                                {%- assign colorMatched = true -%}
                                {%- break -%}
                              {%- endif -%}
                            {%- endfor -%}
                            {%- unless colorMatched -%}
                              style= 'background: rgb( {{ value.swatch.color.rgb }} )'
                            {%- endunless -%}
                            class="variant__color swatch--unavailable{% if shape == 'square' %} swatch--square{% endif %} {% if forloop.first %}active{% endif %} focus-offset"
                          {% endif %}
                        ></color-swatch>
                      {% else %}
                        {%- if value != 'blank' and product_color_swatch == true -%}
                          <color-swatch class="{% if selected_variant.image.src and settings.variant_images == true %}variant__image {% else %}variant__color{% endif %} {% if forloop.first %}active{% endif %} focus-offset" tabindex="0" {% if selected_variant.image.src %}data-variant-id="{{ selected_variant.id }}" data-variant-image="{{ selected_variant.image.src | image_url: width: 550 }}"{% else %}data-variant-id="{{ card_product.id }}" data-variant-image="{{ card_product.featured_media.image | image_url: width: 550 }}"{% endif %}
                            {%- if selected_variant.image.src and settings.variant_images -%}
                              style="background-image: url({{ selected_variant.image.src | image_url: width: 550 }});"
                            {%- else -%}
                              {%- assign variantColorMatched = false -%}
                              {%- for colorData in swatchColors -%}
                                {%- assign colorDatastep = colorData | split:":" -%}
                                {%- assign ruleName = colorDatastep[0] | strip -%}
                                {%- if value == ruleName -%}
                                  {%- assign colorCodes = colorDatastep[1] | strip | split :"#" -%}
                                  {%- assign colorNumber = 0 | plus: colorCodes.size -%}
                                  {%- case colorNumber -%} 
                                    {%- when 2 -%}
                                      style="background: #{{ colorCodes[1] }}; --border-color: #{{ colorCodes[1] }};"
                                    {%- when 3 -%}
                                      style="background: linear-gradient(135deg, #{{colorCodes[1]}} 50%, #{{colorCodes[2]}} 50%); --border-color: #{{ colorCodes[1] }};"
                                    {%- when 4 -%}
                                      style="background: linear-gradient(to right,#{{ colorCodes[1] }} 33%, #{{ colorCodes[2] }} 33%, #{{ colorCodes[2] }} 66%, #{{ colorCodes[3] }} 66%);"
                                    {%- else -%}
                                      style="background-image:url({{ colorCodes[0] | downcase | replace: ' ', '-' | file_img_url }}); background-size: contain; background-repeat: no-repeat; --border-color: {{ value }};"
                                  {%- endcase -%}
                                  {%- assign variantColorMatched = true -%}
                                  {%- break -%}
                                {%- endif -%}
                              {%- endfor -%}
                              {%- unless variantColorMatched -%}
                                style="background-color: {{ value }};"
                              {%- endunless -%}
                            {%- endif -%}>
                          </color-swatch>
                        {%- endif -%}
                      {% endif %}
                    {%- endfor -%}              
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {% endif %}
          </div>
        </div>

        {%- unless show_quick_add == 'none' -%}
          <div class="quick-add no-js-hidden">
            {%- liquid
              assign product_form_id = 'quick-add-' | append: section_id | append: card_product.id | append: '-' | append: display_variant.id
              assign qty_rules = false
              if display_variant.quantity_rule.min > 1 or display_variant.quantity_rule.max != null or display_variant.quantity_rule.increment > 1
                assign qty_rules = true
              endif
            -%}
            {%- if show_quick_add == 'quick' -%}
              <modal-opener data-modal="#QuickAdd-{{ card_product.id }}">
                <button id="{{ product_form_id }}-submit" type="submit" name="add"
                  class="quick-add__submit {% if button_style == 'solid' %}button button--primary animated-button {% else %}button animated-button button--secondary{% endif %}{% if horizontal_quick_add %} card--horizontal__quick-add animate-arrow{% endif %}"
                  aria-haspopup="dialog"
                  aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                  data-product-url="{{ card_url }}"
                >
                 <div><span>{{ 'products.product.choose_options' | t }}</span></div>
                  {%- if horizontal_quick_add -%}
                    <span class="icon-wrap">{% render 'icon' with 'arrow' %}</span>
                  {%- endif -%}
                  {%- render 'loading-spinner' -%}
                </button>
              </modal-opener>

              <quick-add-modal id="QuickAdd-{{ card_product.id }}" class="quick-add-modal">
                <div role="dialog" aria-label="{{ 'products.product.choose_product_options' | t: product_name: card_product.title | escape }}" aria-modal="true" class="quick-add-modal__content global-settings-popup" tabindex="-1">
                  <button id="ModalClose-{{ card_product.id }}" type="button" class="quick-add-modal__toggle" aria-label="{{ 'accessibility.close' | t }}">
                    {%- render 'icon' with 'close' -%}
                  </button>
                  <div id="QuickAddInfo-{{ card_product.id }}" class="quick-add-modal__content-info"></div>
                </div>
              </quick-add-modal>

            {%- elsif show_quick_add == 'add' -%}
              <product-form data-section-id="{{ section.id }}">
                <div class="product-form__error-message-wrapper" role="alert" hidden>
                  <span class="product-form__error-message"></span>
                </div>
                {%- form 'product', card_product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                  <input type="hidden" name="id" data-productid="{{ card_product.id }}" value="{{ display_variant.id }}" class="product-variant-id" {% if display_variant.available == false %} disabled{% endif %}>
                  <button
                    id="{{ product_form_id }}-submit"
                    type="submit"
                    name="add"
                    class="{% if cart_drawerButton %}link {% else %} {% if button_style == 'solid' %}button button--primary {% if display_variant.available %} animated-button{% endif %} {% else %}button animated-button button--secondary{% endif %} {% endif %}{% if horizontal_quick_add %} card--horizontal__quick-add{% endif %}"
                    aria-haspopup="dialog"
                    aria-labelledby="{{ product_form_id }}-submit title-{{ section_id }}-{{ card_product.id }}"
                    aria-live="polite"
                    data-sold-out-message="true"
                    {% if display_variant.available == false %}
                      disabled
                    {% endif %}>
                    {%- if display_variant.available == false -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- else -%}
                      <div><span>{{ 'products.product.add_to_cart' | t }}</span></div> 
                    {%- endif -%}
                    <span class="sold-out-message hidden">{{ 'products.product.sold_out' | t }}</span>
                    {%- if horizontal_quick_add -%}
                      <span class="icon-wrap">{%- render 'icon' with 'plus' -%}</span>
                    {%- endif -%}
                    {%- render 'loading-spinner' -%}
                  </button>
                {%- endform -%}
              </product-form>
            {%- endif -%}
          </div>
        {%- endunless -%}

        {%- if show_badge == true -%}
          <div class="card__badge {{ settings.badge_position }}">
            {%- if card_product.available == false -%}
              <span id="Badge-{{ section_id }}-{{ card_product.id }}" class="badge badge--bottom-left color-{{ settings.sold_out_badge_color_scheme }}">
                {{- 'products.product.sold_out' | t -}}
              </span>
            {%- elsif card_product.compare_at_price > card_product.price and card_product.available -%}
              <span id="Badge-{{ section_id }}-{{ card_product.id }}" class="badge badge--bottom-left gradient color-{{ settings.sale_badge_color_scheme }}">
                {{- 'products.product.on_sale' | t -}}
              </span>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>
    </div>
  </div>

{%- else -%}
  {%- liquid
    assign ratio = 1
    if media_aspect_ratio == 'portrait'
      assign ratio = 0.8
    endif
  -%}
  <div class="card-wrapper product-card-wrapper underline-links-hover">
    <div class="card card--{{ settings.card_style }} {% if extend_height %} card--extend-height{% endif %} {% if image_shape and image_shape != 'default' %} card--shape{% endif %} {% if settings.card_style == 'standard' %} color-{{ settings.card_color_scheme }} gradient{% endif %}" style="--ratio-percent: {{ 1 | divided_by: ratio | times: 100 }}%;">
      <div class="card__inner ratio">
        <div class="card__media {% if image_shape and image_shape != 'default' %} shape--{{ image_shape }} color-{{ settings.card_color_scheme }} gradient{% endif %}">
          <div class="media media--transparent">
            {%- if placeholder_image -%}
              {{ placeholder_image | placeholder_svg_tag: 'placeholder-svg' }}
            {%- else -%}
              {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
        </div>
      </div>
      <div class="card__content{% if settings.card_style == 'card' %} color-{{ settings.card_color_scheme }} gradient{% endif %}">
        <div class="card__information">
          <a role="link" class="card__heading card__heading--placeholder product-title{% if settings.card_style == 'standard' %} h5{% endif %}" title="{{ 'onboarding.product_title' | t }}" aria-disabled="true" class="full-unstyled-link">
            {{ 'onboarding.product_title' | t }}
          </a>
          <div class="card-information">
            {%- if show_vendor -%}
              <span class="visually-hidden">{{ 'accessibility.vendor' | t }}</span>
              <div class="caption-with-letter-spacing light">{{ 'products.product.vendor' | t }}</div>
            {%- endif -%}
            {% render 'price', show_compare_at_price: true %}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

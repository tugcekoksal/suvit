{% comment %}
  Renders a swatch component.
  Accepts:
  - swatch: {Object} a swatch object
  - shape: {String} swatch shape. Accepts 'square', defaults to circle.

  Usage:
  {% render 'swatch',
    swatch: value.swatch
    shape: 'square'
    value:value
  %}
{% endcomment %}
{%- liquid
  assign swatch_value = null
  assign swatch_image_class = null
  if swatch.image and settings.variant_images
    assign image_url = swatch.image | image_url: width: 100
    assign swatch_value = 'url(' | append: image_url | append: ')'
    assign swatch_focal_point = swatch.image.presentation.focal_point
    assign swatch_image_class = 'variant_image'
  elsif swatch.color
    assign swatchColors = settings.swatchColors | newline_to_br | split: '<br />'
    assign variantColorMatched = false
    for colorData in swatchColors
      assign colorDatastep = colorData | split:":"
      assign ruleName = colorDatastep[0] | strip
      if value == ruleName
        assign colorvalue = value
        assign colorrulename = ruleName
        assign colorCodes = colorDatastep[1] | strip | split :"#"
        assign colorNumber = 0 | plus: colorCodes.size
        case colorNumber
          when 2
            assign swatch_value = '#'| append: colorCodes[1] | append: '; --border-color: #' | append: colorCodes[1]
          when 3
            assign swatch_value = "linear-gradient(135deg, #" | append:colorCodes[1]| append:" 50%, #" | append:colorCodes[2] | append:" 50%); --border-color: #" | append: colorCodes[1]
          when 4
            assign swatch_value = "linear-gradient(to right,#"| append:colorCodes[1] | append:" 33%, #"| append:colorCodes[2] | append:" 33%, #"| append:colorCodes[2] | append: " 66%, #" | append:colorCodes[3] | append:" 66%)"
          else
            assign swatch_value = "url(" | append:colorCodes[0] | downcase | replace: ' ', '-' | file_img_url | append:"); background-size: contain; background-repeat: no-repeat; --border-color: "| append: value
        endcase
        assign variantColorMatched = true
        break
      endif
    endfor
    unless variantColorMatched
      assign swatch_value = 'rgb(' | append: swatch.color.rgb | append: ')'
    endunless
  endif
-%}

<span
  {% if swatch_value %}
    class="swatch{% if shape == 'square' %} swatch--square{% endif %} {{ swatch_image_class }}"
    style="--swatch--background: {{ swatch_value }};{% if swatch_focal_point %} --swatch-focal-point: {{ swatch_focal_point }};{% endif %}"
  {% else %}
    class="swatch swatch--unavailable{% if shape == 'square' %} swatch--square{% endif %}"
  {% endif %}
></span>
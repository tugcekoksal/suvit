{%- if request.design_mode -%}
  {% style %}
    .maximize-theme:not(.dark) .quick-help-popup__subscribed,
    .maximize-theme:not(.dark) .quick-help-popup__footer { 
      background: linear-gradient(135deg, #C2EAFF 0%, #FFF 100%);
    }
    .quick-help-popup__email-input::placeholder {
      opacity: 0.6 !important;
    }
    .quick-help-popup__email-input::-moz-placeholder {
      opacity: 0.6 !important;
    }
  {% endstyle %}
  <div x-data="xQuickHelpPopup">

    {%- comment -%} Popup A — Paid / Subscribed {%- endcomment -%}
    <div
      class="quick-help-popup fixed z-50 bottom-0 md:bottom-8 right-0 md:right-8 pointer-events-auto text-left rtl:text-right"
      role="dialog"
      aria-modal="true"
      x-show="showPopupA"
      x-cloak
      x-transition:enter="transition-all ease-in-out duration-300"
      x-transition:enter-start="opacity-0 md:translate-x-4 translate-y-4 md:translate-y-0"
      x-transition:enter-end="opacity-100 md:translate-x-0 translate-y-0"
      x-transition:leave="transition-all ease-in-out duration-300"
      x-transition:leave-end="opacity-0 md:translate-x-4 translate-y-4 md:translate-y-0"
      @keyup.escape.window="closePopupA()"
    >
      <div class="relative w-full max-w-[400px] shadow-xl rounded-3xl pt-5 px-1 pb-1" style="background: linear-gradient(135deg, #4C9CFD 0%, #c084fc 50%, #EE1FBA 100%);">
        <div class="quick-help-popup__container relative color-{{ settings.color_schemes_light }} dark-color-{{ settings.color_schemes_dark }} rounded-3xl overflow-hidden">
          <button
            aria-label="{{ 'accessibility.close' | t }}"
            class="quick-help-popup__button-close cursor-pointer flex h-fit absolute top-4 right-4 z-10 opacity-50 hover:opacity-100 transition-opacity"
            @click.prevent.stop="closePopupA()"
            @keyup.enter.stop="closePopupA()"
            @keydown.enter.prevent
          >
            <span class="button__close icon-close-xsmall-desktop icon-close-xsmall-mobile">
              {% render 'icon-all', icon: 'icon-close' %}
            </span>
          </button>

          <div class="quick-help-popup__subscribed p-6">
            <h2 class="text-lg font-bold m-0 mb-4 leading-tight">Need more help with Maximize?</h2>
            <ul class="m-0 p-0 list-none flex flex-col gap-1 text-sm leading-relaxed">
              <li>
                <span class="mr-1" aria-hidden="true">📘</span>
                <a href="https://support.omnithemes.com/blogs/themes/maximize-theme" target="_blank" rel="noopener" class="font-semibold underline hover:opacity-70">User Guide</a>
                <span class="opacity-70"> – Setup &amp; usage instructions</span>
              </li>
              <li>
                <span class="mr-1" aria-hidden="true">💬</span>
                <a href="https://omnithemes.com/contact/" target="_blank" rel="noopener" class="font-semibold underline hover:opacity-70">Contact Support</a>
                <span class="opacity-70"> – Get help from our team</span>
              </li>
              <li>
                <span class="mr-1" aria-hidden="true">✨</span>
                <a href="https://omnithemes.com/showcase/?_theme_name=Maximize" target="_blank" rel="noopener" class="font-semibold underline hover:opacity-70">Showcase</a>
                <span class="opacity-70"> – Find some inspirations with real stores using Maximize</span>
              </li>
            </ul>
            <p class="text-sm italic opacity-60 m-0 mt-5">Note: this popup will not appear on your store.</p>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Popup B — Free / Unsubscribed (full) {%- endcomment -%}
    <div
      class="quick-help-popup fixed z-50 bottom-0 md:bottom-8 right-0 md:right-8 pointer-events-auto text-left rtl:text-right"
      role="dialog"
      aria-modal="true"
      x-show="showPopupB"
      x-cloak
      x-transition:enter="transition-all ease-in-out duration-300"
      x-transition:enter-start="opacity-0 transform md:translate-x-1/3 translate-y-1/3 md:translate-y-0"
      x-transition:enter-end="opacity-100 transform md:translate-x-0 translate-y-0"
      x-transition:leave="transition-all ease-in-out duration-300"
      x-transition:leave-end="opacity-0 transform md:translate-x-1/3 translate-y-1/3 md:translate-y-0"
      @keyup.escape.window="closePopupB()"
    >
      <div class="w-full shadow-xl max-w-[440px] rounded-3xl pt-5 px-1 pb-1" style="background: linear-gradient(135deg, #4C9CFD 0%, #FF9187 55%, #EE1FBA 100%);">
        <div
          class="quick-help-popup__container relative !bg-gradient-no-alpha color-{{ settings.color_schemes_light }} dark-color-{{ settings.color_schemes_dark }} rounded-[22px] overflow-hidden"
        >
          <button
            aria-label="{{ 'accessibility.close' | t }}"
            class="quick-help-popup__button-close cursor-pointer flex h-fit absolute top-4 right-4 md:top-5 md:right-5 z-10 opacity-50 hover:opacity-100 transition-opacity"
            @click.prevent.stop="closePopupB()"
            @keyup.enter.stop="closePopupB()"
            @keydown.enter.prevent
          >
            <span class="button__close icon-close-xsmall-desktop icon-close-xsmall-mobile">
              {% render 'icon-all', icon: 'icon-close' %}
            </span>
          </button>

          <div class="p-6 text-center flex flex-col gap-4">
            <h2 class="text-xl font-bold m-0 leading-tight">Want a free set up?</h2>
            <p class="text-sm m-0 px-2 opacity-80 leading-relaxed">
              You didn't open a store to battle font sizes.<br> Hand it over — our team will handle the design &amp; setup, free of charge.
            </p>

            <div class="quick-help-popup__email-form">
              <div class="flex flex-col gap-3">
                <div class="text-field__content w-full">
                  <input
                    type="email"
                    name="contact[email]"
                    class="quick-help-popup__email-input text-field__input w-full !border-none text-sm"
                    style="background-color: rgba(128,128,128,0.1); padding: 14px 16px; border-radius: 8px;"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    placeholder="Your email here...."
                    x-model="email"
                    @input.debounce.500ms="errorEmail = validateEmail(email); isSubscribed = false"
                    required
                    :disabled="isSubscribed"
                    x-show="!isSubscribed"
                  >
                  <div
                    class="quick-help-popup__success-message flash-message success-message mx-auto text-sm flex items-center gap-x-2 text-left"
                    x-show="isSubscribed"
                    x-cloak
                  >
                    <span class="inline-block w-4 h-4">
                      {%- render 'icon-all', icon: 'icon-tick' -%}
                    </span>
                    <p class="flex-1 m-0">Thanks! We will contact you soon</p>
                  </div>
                </div>
                <button
                  type="button"
                  class="quick-help-popup__subscribe-button button w-fit mx-auto py-3.5 px-6 rounded-full font-bold text-black border-none cursor-pointer relative overflow-hidden transition-opacity hover:opacity-90 flex justify-center items-center text-sm"
                  :style="isSubscribed ? 'background: rgba(var(--color-secondary-button)); opacity: 1' : 'background: linear-gradient(135deg, #C2EAFF 0%, #4C9CFD 100%); opacity: 1'"
                  :disabled="errorEmail.isError === true || isSubscribed"
                  @click.prevent="handleClickButtonSubscribe('{{ shop.url }}', '{{ shop.email }}', '{{ settings.selected_preset }}', '{{ shop.id }}')"
                >
                  <span
                    class="block"
                    :class="loadingSubscribe ? 'opacity-0' : ''"
                  >
                    Claim my free set up
                  </span>
                  <div
                    class="absolute inset-0 flex items-center justify-center pointer-events-none"
                    x-show="loadingSubscribe"
                    x-cloak
                  >
                    <span class="w-5 h-5 block animate-spin text-black">
                      {% render 'icon-all', icon: 'icon-loading' %}
                    </span>
                  </div>
                </button>
              </div>
            </div>
          </div>

          <div class="quick-help-popup__footer px-6 py-5 text-center border-t border-black/[0.06] dark:border-white/[0.08]">
            <h3 class="text-sm font-bold m-0 mb-2.5">Need more help with Maximize?</h3>
            <p class="text-sm m-0 flex justify-center items-center gap-x-3 gap-y-2 flex-wrap">
              <span class="flex items-center gap-1">📘 <a href="https://support.omnithemes.com/blogs/themes/maximize-theme" target="_blank" rel="noopener" class="underline hover:opacity-70">User Guide</a></span>
              <span class="opacity-30">|</span>
              <span class="flex items-center gap-1">💬 <a href="https://go.crisp.chat/chat/embed/?website_id=5e366ec4-30b5-4074-abce-ef95ae74b337" target="_blank" rel="noopener" class="underline hover:opacity-70">Contact Support</a></span>
              <span class="opacity-30">|</span>
              <span class="flex items-center gap-1">✨ <a href="https://omnithemes.com/showcase/?_theme_name=Maximize" target="_blank" rel="noopener" class="underline hover:opacity-70">Inspiration hub</a></span>
            </p>
            <p class="text-[12px] italic opacity-50 m-0 mt-3">Note: this popup will not appear on your store.</p>
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Popup C — Minimal pill banner {%- endcomment -%}
    <div
      class="quick-help-popup fixed z-50 bottom-4 md:bottom-8 right-4 md:right-8 pointer-events-auto pt-3 px-1 pb-1 rounded-full"
      x-show="showPopupC"
      x-cloak
      x-transition:enter="transition-all ease-in-out duration-300"
      x-transition:enter-start="opacity-0 translate-y-4"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition-all ease-in-out duration-300"
      x-transition:leave-end="opacity-0 translate-y-4"
      style="background: linear-gradient(135deg, #4C9CFD 0%, #FF9187 55%, #EE1FBA 100%);"
    >
      <div
        class="flex items-center gap-2.5 ps-4 pe-3 py-2.5 rounded-full shadow-lg cursor-pointer select-none text-black bg-white"
        @click.prevent="openPopupBFromC()"
        role="button"
        tabindex="0"
        @keyup.enter.prevent="openPopupBFromC()"
      >
        <span class="text-sm font-semibold whitespace-nowrap leading-none">Still customizing? Let us help!</span>
        <button
          aria-label="{{ 'accessibility.close' | t }}"
          class="flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full opacity-70 hover:opacity-100 hover:bg-white/20 transition-all"
          @click.prevent.stop="closePopupC()"
          @keyup.enter.stop="closePopupC()"
          @keydown.enter.prevent
        >
          <span class="button__close icon-close-xsmall-desktop icon-close-xsmall-mobile">
            {% render 'icon-all', icon: 'icon-close' %}
          </span>
        </button>
      </div>
    </div>

  </div>

  <script>
    requestAnimationFrame(() => {
      document.addEventListener('alpine:init', () => {
        Alpine.data('xQuickHelpPopup', () => ({
          showPopupA: false,
          showPopupB: false,
          showPopupC: false,
          TIMEOUT_SHOW_POPUP: 300,
          email: '',
          loadingSubscribe: false,
          errorEmail: validateEmail(''),
          isSubscribed: false,

          init() {
            const isPurchased = ['main'].includes(Shopify.theme.role);
            const subscribedEmail = localStorage.getItem('maximize_subscribed_email');
            const isAlreadySubscribed = !!subscribedEmail && subscribedEmail === '{{ shop.email }}';

            if (isPurchased || isAlreadySubscribed) {
              this._initFlowA();
            } else {
              this._initFlowB();
            }
          },

          _initFlowA() {
            const closeCount = parseInt(localStorage.getItem('maximize_paid_close_count') || '0');
            const nextShow   = parseInt(localStorage.getItem('maximize_paid_next_show')   || '0');
            const now        = Date.now();

            if (closeCount >= 2) return;
            if (closeCount === 1 && now < nextShow) return;

            setTimeout(() => { this.showPopupA = true; }, this.TIMEOUT_SHOW_POPUP);
          },

          _initFlowB() {
            const state = localStorage.getItem('maximize_free_state');

            if (!state || state === 'full') {
              localStorage.setItem('maximize_free_state', 'full');
              setTimeout(() => { this.showPopupB = true; }, this.TIMEOUT_SHOW_POPUP);
            } else if (state === 'minimal') {
              setTimeout(() => { this.showPopupC = true; }, this.TIMEOUT_SHOW_POPUP);
            }
          },

          closePopupA() {
            this.showPopupA = false;
            const count = parseInt(localStorage.getItem('maximize_paid_close_count') || '0') + 1;
            localStorage.setItem('maximize_paid_close_count', String(count));
            if (count === 1) {
              localStorage.setItem('maximize_paid_next_show', String(Date.now() + 7 * 24 * 60 * 60 * 1000));
            }
          },

          closePopupB() {
            this.showPopupB = false;
            localStorage.setItem('maximize_free_state', 'minimal');
            setTimeout(() => { this.showPopupC = true; }, 350);
          },

          openPopupBFromC() {
            this.showPopupC = false;
            localStorage.setItem('maximize_free_state', 'full');
            setTimeout(() => { this.showPopupB = true; }, 350);
          },

          closePopupC() {
            this.showPopupC = false;
            localStorage.setItem('maximize_free_state', 'dismissed');
          },

          async handleClickButtonSubscribe(url, ct, preset, shopId) {
            if (this.errorEmail.isError !== true && !this.loadingSubscribe) {
              this.loadingSubscribe = true;
              const success = await Alpine.store('xCc').subscribeEmail(url, ct, preset, shopId, this.email);
              if (success) {
                this.isSubscribed = true;
                localStorage.setItem('maximize_subscribed_email', this.email);
                localStorage.removeItem('maximize_free_state');
                localStorage.removeItem('maximize_paid_close_count');
                localStorage.removeItem('maximize_paid_next_show');
              }
              this.loadingSubscribe = false;
            }
          }
        }));
      });
    });
  </script>
{%- endif -%}
